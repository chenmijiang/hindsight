# 默认（官方文档）：`http://localhost:4000`；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_LITELLM_API_BASE=http://localhost:4000
# LiteLLM proxy API key for embeddings (optional, depends on proxy config; falls back to
# `HINDSIGHT_API_LITELLM_API_KEY`)
# 默认（官方文档）：-；下一行为上游示例值。
# 安全：敏感凭证占位符；请替换并保护 .env，勿提交或公开。
# HINDSIGHT_API_EMBEDDINGS_LITELLM_API_KEY=your-litellm-key
# LiteLLM embedding model (use provider prefix, e.g., `cohere/embed-english-v3.0`)
# 默认（官方文档）：`text-embedding-3-small`；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_LITELLM_MODEL=text-embedding-3-small
# Vector width the configured LiteLLM model returns. When set, the startup dimension probe is skipped, so the API
# boots even while the proxy is still starting. Declares the width rather than requesting it (the value is not sent
# to the proxy); a wrong value fails the first embedding call with an explicit error.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_LITELLM_DIMENSIONS=1536  # declare the vector width to skip the startup probe
# For LiteLLM SDK embeddings (no proxy; provider credentials read from the environment):
# Provider: `local`, `onnx`, `tei`, `hindsight`, `openai`, `openai-codex`, `openrouter`, `requesty`, `cohere`,
# `google`, `zeroentropy`, `nvidia`, `litellm`, or `litellm-sdk`
# 默认（官方文档）：`local`；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_PROVIDER=litellm-sdk
# LiteLLM SDK embedding model (use provider prefix, e.g., `cohere/embed-english-v3.0`)
# 默认（官方文档）：`cohere/embed-english-v3.0`；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_LITELLM_SDK_MODEL=bedrock/amazon.titan-embed-text-v2:0
# Bedrock only: invoke this target instead of the model above (e.g. an application
# inference profile ARN, when a Service Control Policy denies the bare model id).
# LiteLLM picks the Bedrock payload shape from _MODEL, which must stay a recognizable
# id, so the opaque ARN goes here.
# **Bedrock only.** The target LiteLLM actually invokes, when it differs from `..._MODEL` — typically an [application
# inference profile](https://docs.aws.amazon.com/bedrock/latest/userguide/inference-profiles-support.html) ARN, which
# you need when a Service Control Policy denies `bedrock:InvokeModel` on the bare model id. LiteLLM picks the Bedrock
# request/response shape from `..._MODEL`, so leave that a recognizable id (e.g.
# `bedrock/amazon.titan-embed-text-v2:0`) and put the ARN here.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_LITELLM_SDK_MODEL_ID=arn:aws:bedrock:eu-west-1:123456789012:application-inference-profile/abc123
# For ZeroEntropy zembed-1:
# Provider: `local`, `onnx`, `tei`, `hindsight`, `openai`, `openai-codex`, `openrouter`, `requesty`, `cohere`,
# `google`, `zeroentropy`, `nvidia`, `litellm`, or `litellm-sdk`
# 默认（官方文档）：`local`；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_PROVIDER=zeroentropy
# ZeroEntropy API key for embeddings
# 默认（官方文档）：-；下一行为上游示例值。
# 安全：敏感凭证占位符；请替换并保护 .env，勿提交或公开。
# HINDSIGHT_API_EMBEDDINGS_ZEROENTROPY_API_KEY=ze-xxxx
# ZeroEntropy embedding model
# 默认（官方文档）：`zembed-1`；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_ZEROENTROPY_MODEL=zembed-1
# Output dimensions for `zembed-1`. Supported values: `2560`, `1280`, `640`, `320`, `160`, `80`, `40`
# 默认（官方文档）：`1280`；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_ZEROENTROPY_DIMENSIONS=1280
# Response encoding: `float` or `base64`. Hindsight decodes either format to float vectors before storage.
# 默认（官方文档）：`float`；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_ZEROENTROPY_ENCODING_FORMAT=float
# Optional latency mode: `fast` or `slow`. Leave unset to use ZeroEntropy's default routing.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_ZEROENTROPY_LATENCY=fast
# For NVIDIA NIM (sends input_type=query/passage):
# Provider: `local`, `onnx`, `tei`, `hindsight`, `openai`, `openai-codex`, `openrouter`, `requesty`, `cohere`,
# `google`, `zeroentropy`, `nvidia`, `litellm`, or `litellm-sdk`
# 默认（官方文档）：`local`；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_PROVIDER=nvidia
# NVIDIA NIM API key (`nvapi-...`) for embeddings
# 默认（官方文档）：-；下一行为上游示例值。
# 安全：敏感凭证占位符；请替换并保护 .env，勿提交或公开。
# HINDSIGHT_API_EMBEDDINGS_NVIDIA_API_KEY=nvapi-xxxx
# NVIDIA embedding model
# 默认（官方文档）：`nvidia/llama-nemotron-embed-vl-1b-v2`；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_NVIDIA_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
# Base URL; requests go to `{base}/embeddings` (point it at a self-hosted NIM to use one)
# 默认（官方文档）：`https://integrate.api.nvidia.com/v1`；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Output dimensions sent with each request. Must be a size the model accepts (`nvidia/nemotron-3-embed-1b` only does
# `2048`, which needs a vector extension other than `pgvector`)
# 默认（官方文档）：`1024`；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_NVIDIA_DIMENSIONS=1024
# Max inputs per NVIDIA embed request
# 默认（官方文档）：`100`；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_NVIDIA_BATCH_SIZE=100
#
# IMPORTANT: Embedding keys require provider-specific names:
# HINDSIGHT_API_EMBEDDINGS_{PROVIDER}_{PARAMETER}
# (for example, HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL).
#
# DeepSeek note: DeepSeek is supported for LLM calls, but not for embeddings.
# If using DeepSeek as LLM provider, keep embeddings on local/openai/cohere/google/etc.

# Retry policy for remote embedding calls (litellm / litellm-sdk providers).
# Transient upstream failures (5xx, timeouts, connection errors) are retried with
# jittered exponential backoff; 4xx auth/validation errors are never retried.
# Retries after the first attempt when a remote embedding call fails transiently (5xx, timeout, connection error).
# `0` disables retrying. Applies to the `litellm`, `litellm-sdk`, `google` (Gemini API / Vertex AI), `cohere`,
# `zeroentropy` and `nvidia` providers — none of which retry on their own — including Gemini `429 RESOURCE_EXHAUSTED`
# quota responses; 4xx auth/validation errors are never retried. The `openai`, `openai-codex`, `openrouter`,
# `requesty` and `hindsight` providers pass it to the OpenAI SDK as its retry count, and also retry their startup
# dimension probe (sent for a model whose dimension is not known) with this backoff and budget, so a rate-limited
# endpoint does not stop the API from starting; an OpenAI `429 insufficient_quota` (out of credits) then parks the
# operation for 15 minutes instead of failing it. (`tei` uses its own built-in retry instead.)
# 默认（官方文档）：`4`；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_MAX_RETRIES=4        # retries after the first attempt; 0 disables
# Initial backoff in seconds between embedding retries (doubles per attempt, with jitter)
# 默认（官方文档）：`0.5`；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_INITIAL_BACKOFF=0.5  # seconds; doubles per attempt, with jitter
# Cap on the backoff between embedding retries, in seconds
# 默认（官方文档）：`4.0`；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_MAX_BACKOFF=4.0      # cap on per-retry backoff, seconds
# Wall-clock ceiling, in seconds, on the time one `encode()` call may spend retrying (failed attempts plus backoff).
# Keeps a degraded provider from stalling a synchronous recall.
# 默认（官方文档）：`15.0`；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_RETRY_BUDGET=15.0    # wall-clock ceiling per encode() spent retrying

# Embedding similarity thresholds. These defaults preserve the behavior calibrated
# for BAAI/bge-small-en-v1.5. Recalibrate each threshold independently when changing
# embedding models because cosine-similarity distributions are model-dependent.
# Minimum cosine similarity a candidate must reach to be returned by the semantic retrieval strategy. Must be between
# `0` and `1`.
# 默认（官方文档）：`0.3`；下一行为上游示例值。
# HINDSIGHT_API_SEMANTIC_MIN_SIMILARITY=0.3
# Minimum cosine similarity for a memory to seed graph retrieval. This is independent from the main semantic
# retrieval threshold. Must be between `0` and `1`.
# 默认（官方文档）：`0.3`；下一行为上游示例值。
# HINDSIGHT_API_GRAPH_SEED_MIN_SIMILARITY=0.3
# Minimum cosine similarity for temporal retrieval entry points and spread neighbors. This is independent from the
# main semantic retrieval threshold. Must be between `0` and `1`.
# 默认（官方文档）：`0.1`；下一行为上游示例值。
# HINDSIGHT_API_TEMPORAL_SEMANTIC_MIN_SIMILARITY=0.1
# Minimum cosine similarity for creating semantic links during normal retain, streaming retain, and graph-maintenance
# relinking. This directly controls semantic graph density. Must be between `0` and `1`.
# 默认（官方文档）：`0.7`；下一行为上游示例值。
# HINDSIGHT_API_SEMANTIC_LINK_MIN_SIMILARITY=0.7
# Cosine similarity at/above which a newly-created or freshly-updated observation is reconciled against an existing
# near-identical one via a focused 1-by-1 LLM "merge or keep" call (the model reads both texts, so a
# number/negation/entity difference is respected). Catches near-duplicate observations that weaker consolidation
# models emit even when shown the twin, as well as duplicates that arise when an update rewrites an observation into
# a near-twin of another. Set to `1.0` to disable. Postgres only — consolidation skips reconciliation on Oracle
# regardless of this value.
# 默认（官方文档）：`0.97`；下一行为上游示例值。
# HINDSIGHT_API_CONSOLIDATION_DEDUP_THRESHOLD=0.97

# Per-scope consolidation settings: a JSON list of strategies, each claiming one or
# more tag scopes and overriding the observations mission, observation cap and/or
# source-facts token limits for them. Lets one bank keep detailed per-user observations while a shared scope stays
# generic. Usually set per bank; see docs/developer/observations.
# Per-scope consolidation settings, as a JSON array of `{"scopes": [{"tags": [tag-globs], "tags_match": "all" \|
# "exact"}, ...], "observations_mission": str, "max_observations_per_scope": int,
# "consolidation_source_facts_max_tokens": int, "consolidation_source_facts_max_tokens_per_observation": int}`
# strategies. Each strategy lists the scopes it claims — a scope is a list of
# [fnmatch](https://docs.python.org/3/library/fnmatch.html) globs, and a consolidation pass is claimed when *any* of
# the strategy's patterns matches its tags. Each pattern's `tags_match` sets how: `"all"` (default) — the scope has
# every tag in the pattern, other tags allowed; `"exact"` — exactly those tags and no others. Every setting is
# optional. **Exactly one strategy applies to a scope: the first in the list that claims it.** Whatever that strategy
# leaves unset — and every scope no strategy claims — uses the bank-wide `OBSERVATIONS_MISSION`,
# `MAX_OBSERVATIONS_PER_SCOPE`, `CONSOLIDATION_SOURCE_FACTS_MAX_TOKENS` and
# `CONSOLIDATION_SOURCE_FACTS_MAX_TOKENS_PER_OBSERVATION`. This supersedes `OBSERVATION_SCOPE_LIMITS` and is what
# lets a single bank be federated across user / team / company tag scopes: each scope is consolidated by its own LLM
# call, so each can follow a different brief. Example: `[{"scopes": [{"tags": ["company:*"]}],
# "observations_mission": "Record only generalized, industry-level trends. Never name a specific company, deal size,
# or funding stage."}]` keeps per-user scopes detailed while the company-wide scope stays generic. Configurable per
# bank.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_CONSOLIDATION_STRATEGIES='[{"scopes": [{"tags": ["company:*"]}], "observations_mission": "Record only general trends.", "max_observations_per_scope": 20}]'

# observation_scopes for retained items that send none (default: combined). A mode, or a JSON
# list of tag lists where "key:*" matches the memory's own key: tags, e.g. group by topic only.
# `observation_scopes` applied at retain to items that send none: `combined`, `per_tag`, `all_combinations`,
# `shared`, or a JSON list of tag lists, where a tag containing `*` is a glob over the memory's own tags (e.g.
# `[["topic:*"]]` groups memories by their topic tags only). Stored on each memory, so changing it doesn't re-scope
# memories already retained until their document is reprocessed. See
# [observation_scopes](./api/retain#observation_scopes). Configurable per bank.
# 默认（官方文档）：`combined`；下一行为上游示例值。
# HINDSIGHT_API_DEFAULT_OBSERVATION_SCOPES='[["topic:*"]]'

# With a decision model set up for consolidation (HINDSIGHT_API_DECISION_MODEL_* below), it
# settles restatements and chatter next to existing observations before the LLM call; every
# other fact reaches the LLM, which alone writes observation text (LLM calls down ~3-5% on the
# consolidation eval). Set false to send every fact to the LLM. Hierarchical (per bank).
# When a decision model is set up for consolidation (see [Decision model](#decision-model)), it settles the easy
# facts before the consolidation LLM call: a fact that restates an existing observation is attached as its evidence,
# and chatter next to existing observations is skipped. It never writes an observation's text: every other fact (a
# new one, one with no observation to compare against, one that changes what an observation says, one whose answers
# disagree, one whose request failed) goes to the LLM as before. Under a bank's own observations mission, chatter is
# left to the LLM, which applies the mission. Set `false` to send every fact to the LLM. Hierarchical (per bank).
# 默认（官方文档）：`true`；下一行为上游示例值。
# HINDSIGHT_API_CONSOLIDATION_USE_DECISION_MODEL=true

# Floor on how often an automatic mental-model refresh (after-consolidation or cron)
# may run, in seconds. A trigger that fires sooner is queued and parked until the
# window closes, and further triggers fold into it, so a burst of small retains costs
# one refresh instead of one per retain. 0 = no floor (the historical behaviour).
# Hierarchical, and overridable per model via the trigger's min_refresh_interval_seconds.
# Explicit refreshes always run immediately.
# Minimum seconds between two *automatic* refreshes of the same mental model — the after-consolidation trigger and
# the cron schedule. A trigger that fires sooner is not dropped: its refresh is queued and parked until the window
# closes, and every further trigger in the meantime folds into that one queued refresh, so a burst of small retains
# costs one refresh instead of one per retain. Raise it when a bank ingests continuously and its models do not need
# to be current to the minute — the parked refresh still sees everything that accumulated while it waited. Explicit
# refreshes (API, MCP, control plane) ignore the floor and run immediately, and additionally release a parked refresh
# they fold into. `0` = no floor, every trigger refreshes at once. Hierarchical — overridable per bank via the
# [config API](#hierarchical-configuration), and per model via `trigger.min_refresh_interval_seconds` (which wins,
# including an explicit `0` to exempt one hot model from a bank-wide floor).
# 默认（官方文档）：`0`；下一行为上游示例值。
# HINDSIGHT_API_MENTAL_MODEL_MIN_REFRESH_INTERVAL_SECONDS=0

# Default trigger for newly created pages, as a JSON object merged over the
# built-in default ({"mode": "delta", "fact_types": ["observation"],
# "exclude_mental_models": true, "refresh_after_consolidation": true}). A trigger sent
# with the create request still wins. Hierarchical (overridable per bank).
# The old name HINDSIGHT_API_KNOWLEDGE_PAGE_DEFAULT_TRIGGER still works (deprecated).
# Default refresh settings for newly created [pages](./pages), as a JSON object merged over the built-in default
# (`{"mode": "delta", "fact_types": ["observation"], "exclude_mental_models": true, "refresh_after_consolidation":
# true}`). Set only the fields you want to change — e.g. `{"refresh_cron": "0 * * * *"}` makes new pages refresh
# hourly instead of after every consolidation. A trigger sent when creating the page still wins; existing pages are
# not changed. Configurable per bank (`page_default_trigger`). The old name
# `HINDSIGHT_API_KNOWLEDGE_PAGE_DEFAULT_TRIGGER` (bank key `knowledge_page_default_trigger`) still works but is
# deprecated and will be removed in 2.x.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_PAGE_DEFAULT_TRIGGER='{"refresh_cron": "0 * * * *"}'

# Default reflect options, as a JSON object applied whenever a reflect request leaves the
# option unset. Fields: reflect_search_observations_max_tokens
# (budget for the search_observations tool, default 5000),
# reflect_search_observations_include_entities (attach resolved entity names, default true; they can be
# over half the tool payload) and reflect_search_mental_models_max_tokens (budget for the mental models
# search_mental_models returns in full, default 16000; the best match is always in full, the others that
# do not fit come back as a snippet). Hierarchical (overridable per bank). Mental-model refreshes do not
# read this — they take these settings from their own trigger (page_default_trigger).
# A refresh always gets only the best mental model in full and the others as snippets.
# Default reflect options as a JSON object, applied whenever a reflect request leaves the option unset. Mental-model
# refreshes do not read it — they take these settings from their own trigger, defaulted per bank by
# `page_default_trigger`, and always get only the best-ranked mental model in full.
# `reflect_search_observations_max_tokens` sets the budget for the `search_observations` tool (a smaller budget drops
# the lowest-ranked observations and shrinks the reflect context); `reflect_search_observations_include_entities`
# turns off the resolved entity names attached to each observation, which can be more than half the tool payload;
# `reflect_search_mental_models_max_tokens` sets the budget for the mental models `search_mental_models` returns in
# full (default 16000; the best match is always in full, the others that do not fit come back as a snippet the model
# can read). E.g. `{"reflect_search_observations_max_tokens": 3000, "reflect_search_observations_include_entities":
# false}`. Hierarchical — can be overridden per bank via config API.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_REFLECT_DEFAULT_OPTIONS='{"reflect_search_observations_max_tokens": 3000}'
# With a decision model set up for reflect (HINDSIGHT_API_DECISION_MODEL_* below), reflect is
# decision-orchestrated: the layers run in parallel rounds and the decision model prunes the
# evidence and judges when it is enough, in place of one LLM turn per layer. Fewer LLM calls.
# Set false to keep agent turns, for reflect and for page refreshes. Hierarchical (per bank).
# When a decision model is set up for reflect (see [Decision model](#decision-model)), reflect is
# decision-orchestrated: one LLM call rewrites the request into a search query, the layers run in parallel with that
# query, and the decision model prunes the evidence and judges whether it already answers the request. If it does,
# the answer is the next LLM call. If not, the LLM writes the next query and another parallel round runs, judged the
# same way. Fewer LLM calls than agent turns, so it costs less. If the decision model fails, reflect falls back to
# agent turns. Only the `hindsight` and `typesafe` providers are supported here for now: with another provider
# reflect keeps agent turns and logs a warning. Set `false` to keep agent turns (one LLM turn per retrieval layer,
# each writing its own query). Hierarchical (per bank).
# 默认（官方文档）：`true`；下一行为上游示例值。
# HINDSIGHT_API_REFLECT_USE_DECISION_MODEL=true
# The same, for the reflect that refreshes a page. Hierarchical (per bank).
# 默认（官方文档）：`true`；下一行为上游示例值。
# HINDSIGHT_API_MENTAL_MODEL_REFRESH_USE_DECISION_MODEL=true
# Delta page refresh asks the decision model which new memories could change the page, instead of reflect
# When a decision model is set up for reflect (see [Decision model](#decision-model)), a delta page refresh skips
# reflect: it asks the decision model which of the memories added since its last run could change the page, and edits
# the page from those alone. None of them means no LLM call. Set `false` to run reflect for delta refreshes too.
# Hierarchical (per bank).
# 默认（官方文档）：`true`；下一行为上游示例值。
# HINDSIGHT_API_MENTAL_MODEL_DELTA_USE_DECISION_MODEL=true
# Above this many new memories a delta refresh searches instead of asking the decision model about each (server-level)
# The most new memories a delta page refresh asks the decision model about; past it, the refresh runs reflect. See
# [Reflect](#reflect).
# 默认（官方文档）：`200`；下一行为上游示例值。
# HINDSIGHT_API_MENTAL_MODEL_DELTA_GATE_MAX_MEMORIES=200
# How an interactive reflect searches the knowledge banks a memory bank links.
# Media types the search may return (comma-separated: document,image,audio,video,text; unset = all; per bank)
# Comma-separated media types the search may return: some of `document`, `image`, `audio`, `video`, `text`. Unset
# returns all.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_REFLECT_KB_SEARCH_MEDIA_TYPES=
# Show the model the picture behind an image or PDF-page hit, when it is known to read images (server-level)
# Show the reflect model the picture behind an image or PDF-page hit, as an image. Only when the model is known to
# read images (see `HINDSIGHT_API_LLM_VISION`); otherwise the hit stays text.
# 默认（官方文档）：`true`；下一行为上游示例值。
# HINDSIGHT_API_REFLECT_KB_SEARCH_IMAGES=true
# The most pictures one search hands the model (0 = none; server-level)
# The most pictures one search hands the model. Each one costs input tokens. `0` sends none.
# 默认（官方文档）：`4`；下一行为上游示例值。
# HINDSIGHT_API_REFLECT_KB_SEARCH_MAX_IMAGES=4
# How deep the search ranks before its token budget picks: low, mid or high (server-level)
# How deep the search ranks before its token budget picks the results, as the knowledge search's `budget`: `low` is
# fastest, `high` reaches the most candidates.
# 默认（官方文档）：`mid`；下一行为上游示例值。
# HINDSIGHT_API_REFLECT_KB_SEARCH_BUDGET=mid
# Filter the search by the reflect's tags/tags_match/tag_groups, as its memories are (per bank)
# Filter the knowledge-bank search by the reflect's `tags`, `tags_match` and `tag_groups`, with the same rules as its
# memories (`any`/`all` keep untagged documents, the `_strict` modes drop them). `false` searches every document,
# whatever the reflect's tags.
# 默认（官方文档）：`true`；下一行为上游示例值。
# HINDSIGHT_API_REFLECT_KB_SEARCH_APPLY_TAGS=true

# Admission control. The *_MAX_CONCURRENT caps above bound how much runs at once and
# let an unbounded queue form behind them; these bound how long a request may WAIT
# before it is refused with 503 + Retry-After. A queued request whose client
# disconnects releases its place immediately, so a patient deadline costs nothing
# when nobody is still listening.
# Limits are PER WORKER PROCESS and, when left at 0, derived from the CPU budget this
# process actually has (cgroup quota, not the host's core count) divided by
# HINDSIGHT_API_WORKERS. A positive value overrides the derivation; a NEGATIVE value
# disables that lane entirely (0 cannot mean "off", because it means "derive").
# in_flight is a latency target, not a capacity limit: throughput is cores divided by
# CPU-per-request either way. Too low throttles I/O-bound work, too high rebuilds the
# queue this exists to prevent.
# Concurrent recalls admitted per worker before requests queue. `0` derives it from the CPU budget this process has
# (cgroup quota) divided by `HINDSIGHT_API_WORKERS`; a negative value disables the lane. A latency target, not a
# capacity limit: throughput is unchanged either way, but too low throttles I/O-bound work and too high rebuilds the
# queue.
# 默认（官方文档）：`0` (derived)；下一行为上游示例值。
# HINDSIGHT_API_ADMISSION_RECALL_MAX_IN_FLIGHT=0
# How long a recall may queue for a slot before being refused with 503 + `Retry-After`. A queued request whose client
# disconnects releases its place immediately. Absorbs bursts; lower it if load is persistently over capacity, where a
# long queue just delays the same refusals.
# 默认（官方文档）：`30000`；下一行为上游示例值。
# HINDSIGHT_API_ADMISSION_RECALL_MAX_WAIT_MS=30000
# As above, for reflect.
# 默认（官方文档）：`0` (derived)；下一行为上游示例值。
# HINDSIGHT_API_ADMISSION_REFLECT_MAX_IN_FLIGHT=0
# As above, for reflect.
# 默认（官方文档）：`5000`；下一行为上游示例值。
# HINDSIGHT_API_ADMISSION_REFLECT_MAX_WAIT_MS=5000
# As above, for retain. Only bites on the synchronous path; an async retain returns as soon as the operation is
# queued.
# 默认（官方文档）：`0` (derived)；下一行为上游示例值。
# HINDSIGHT_API_ADMISSION_RETAIN_MAX_IN_FLIGHT=0
# As above, for retain.
# 默认（官方文档）：`2000`；下一行为上游示例值。
# HINDSIGHT_API_ADMISSION_RETAIN_MAX_WAIT_MS=2000
# As above, for knowledge-bank search.
# 默认（官方文档）：`0` (derived)；下一行为上游示例值。
# HINDSIGHT_API_ADMISSION_KB_SEARCH_MAX_IN_FLIGHT=0
# As above, for knowledge-bank search.
# 默认（官方文档）：`30000`；下一行为上游示例值。
# HINDSIGHT_API_ADMISSION_KB_SEARCH_MAX_WAIT_MS=30000

# Recall pipeline stages (all on by default). Each is hierarchical, so a single
# bank can switch a stage off via the config API without changing the server
# default. Turning all four off reduces recall to a single vector query, the
# lowest-latency recall path.
# Keyword (BM25) arm. false leaves pure vector search: the arm is left out of the
# query entirely rather than filtered to nothing, so its SQL, its query tokenization
# and its pg_stats term-selection lookup are all skipped. Also drops the keyword arm
# from page search:
# Run the keyword (BM25) retrieval arm. `false` leaves **pure vector search** — the arm is left out of the query
# entirely rather than filtered to nothing, so its SQL, its query tokenization and its `pg_stats` term-selection
# lookup are all skipped. Also drops the keyword arm from page search.
# 默认（官方文档）：`true`；下一行为上游示例值。
# HINDSIGHT_API_ENABLE_TEXT_SEARCH=true
# Temporal retrieval arm, plus the date-aware query analysis that feeds it:
# Run the temporal retrieval arm. `false` also skips the date-aware query analysis that feeds it — without a detected
# constraint there is nothing to filter on.
# 默认（官方文档）：`true`；下一行为上游示例值。
# HINDSIGHT_API_ENABLE_TEMPORAL_RETRIEVAL=true
# Entity/link graph traversal arm:
# Run the entity/link graph traversal arm. `false` skips those queries and returns no graph results.
# 默认（官方文档）：`true`；下一行为上游示例值。
# HINDSIGHT_API_ENABLE_GRAPH_RETRIEVAL=true
# Cross-encoder rerank of the fused candidates (false = use the RRF order):
# Rerank fused candidates with the cross-encoder. `false` returns the RRF-fused ordering directly — faster, but less
# precise.
# 默认（官方文档）：`true`；下一行为上游示例值。
# HINDSIGHT_API_ENABLE_RERANKING=true
# Default recall prefer_observations when a request omits it (drop raw facts an
# observation in the results already covers; request value still wins):
# Value of recall's [`prefer_observations`](./api/recall#prefer_observations) when a REST or MCP request leaves it
# out: drop raw facts that a returned observation was consolidated from, so results carry no duplicates. A value in
# the request still wins. Hierarchical — overridable per bank. Useful when callers you don't control (MCP connectors,
# generic agents) never pass the flag.
# 默认（官方文档）：`false`；下一行为上游示例值。
# HINDSIGHT_API_RECALL_PREFER_OBSERVATIONS=false
# How much recency can move a recall score, 0..1 (0.2 = at most ±10%)
# How much recency can change a memory's final recall score, whatever decay function is used. A memory's score is
# multiplied by a factor between `1 - alpha/2` and `1 + alpha/2`, so the default `0.2` moves it at most ±10% (with
# `linear` decay the oldest memories stop at `1 - 0.4·alpha`, so -8% at the default). Applies when recall reranks
# with combined scoring; `interleave` mode and the decision-model reranker skip it. Raise it when a bank holds
# "current state" documents that are re-ingested on change and the newest matching fact should win over an older,
# slightly better match. `0` turns recency off (same as `HINDSIGHT_API_RECENCY_DECAY_FUNCTION=none`). Must be between
# `0` and `1`; the server refuses to start otherwise.
# 默认（官方文档）：`0.2`；下一行为上游示例值。
# HINDSIGHT_API_RECENCY_ALPHA=0.2

# Reranker Configuration (Optional - uses local by default)
# Provider: "local" (default) or "tei" (HuggingFace Text Embeddings Inference)
# Provider: `local`, `tei`, `cohere`, `openrouter`, `zeroentropy`, `siliconflow`, `nvidia`, `hindsight`, `typesafe`
# (deprecated, see [Decision model](#decision-model)), `alibaba`, `google`, `flashrank`, `onnx`, `litellm`,
# `litellm-sdk`, `jina-mlx`, or `rrf`
# 默认（官方文档）：`local`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_PROVIDER=local
# Applies to any provider: cap each rerank candidate at this many tokens,
# e.g. to fit a small-context model or keep a CPU-only rerank server from running out
# of memory on very long documents. Off by default.
# (Deprecated alias: HINDSIGHT_API_RERANKER_LITELLM_MAX_TOKENS_PER_DOC)
# Applies to **every** provider. If set, truncate each rerank candidate to this many tokens (tiktoken, approximate)
# before reranking. Set it below the model's context window (e.g. `900` for a 1024-token model), or lower to bound
# request size when documents can be very long (keeps a CPU-only rerank server from running out of memory). Each
# fallback member has its own (`HINDSIGHT_API_RERANKER_<n>_MAX_TOKENS_PER_CANDIDATE`). Off by default. (Deprecated
# alias: `HINDSIGHT_API_RERANKER_LITELLM_MAX_TOKENS_PER_DOC`.)
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_MAX_TOKENS_PER_CANDIDATE=900
# Trusted gateway attribution (disabled by default). When enabled, remote
# reranker requests include X-Hindsight-Bank-Id with the current bank ID.
# Add `X-Hindsight-Bank-Id: <bank_id>` to remote reranker requests. Enable only for trusted endpoints because this
# transmits the current bank ID. Covers TEI, Cohere-compatible HTTP, LiteLLM proxy, and LiteLLM SDK transports.
# 默认（官方文档）：`false`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_SEND_BANK_AS_HEADER=false
# Transient upstream failures (5xx, timeouts, connection errors, 429 quota) are
# retried with jittered exponential backoff; 4xx auth/validation errors are never
# retried. Applies to every remote provider except "tei", which retries on its own.
# Retries after the first attempt when a remote rerank call fails transiently (5xx, timeout, connection error, `429`
# quota). `0` disables retrying. Applies to every remote provider except `tei`, which has its own retry loop; the
# in-process providers (`local`, `flashrank`, `onnx`, `jina-mlx`, `rrf`) are unaffected. 4xx auth/validation errors
# are never retried.
# 默认（官方文档）：`3`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_MAX_RETRIES=3        # retries after the first attempt; 0 disables
# Initial backoff in seconds between rerank retries (doubles per attempt, with jitter)
# 默认（官方文档）：`0.5`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_INITIAL_BACKOFF=0.5  # seconds; doubles per attempt, with jitter
# Cap on the backoff between rerank retries, in seconds
# 默认（官方文档）：`4.0`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_MAX_BACKOFF=4.0      # cap on per-retry backoff, seconds
# Wall-clock ceiling, in seconds, on the time one rerank may spend retrying (failed attempts plus backoff). Tighter
# than the embedding budget because rerank runs after retrieval has already spent time on the same request. With a
# fallback chain configured, each member spends its own budget before the chain advances.
# 默认（官方文档）：`10.0`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_RETRY_BUDGET=10.0    # wall-clock ceiling per rerank spent retrying
# For local provider:
# Model for local provider
# 默认（官方文档）：`hindsight-ai/hs-rerank-1`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_LOCAL_MODEL=hindsight-ai/hs-rerank-1
# Force CPU even when a GPU is available (CUDA/XPU auto-select otherwise; Apple
# Silicon MPS is never used):
# Force CPU mode for local reranker even when CUDA/XPU is available
# 默认（官方文档）：`false`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_LOCAL_FORCE_CPU=false
# Wall-clock ceiling for scoring one recall's candidates; on expiry the unscored
# ones keep their pre-rerank order so recall still returns. A safety valve for an
# over-sized model on CPU, not a latency target. 0 disables:
# Wall-clock ceiling for scoring one recall's candidates. On expiry the unscored candidates keep their pre-rerank
# (RRF) order behind the scored ones, so recall still returns. Set far above any healthy rerank — it is a safety
# valve for an over-sized local model on CPU, not a latency target. `0` disables.
# 默认（官方文档）：`300`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_LOCAL_TIMEOUT=300
# For TEI provider:
# TEI server URL
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_TEI_URL=http://localhost:8081
# For cohere provider (native API, or any Cohere-compatible /rerank via BASE_URL):
# Rerank requests in flight per process; the rest wait here, so the timeout measures
# server time. Split what the endpoint can serve across processes sharing it:
# Rerank requests in flight at once per process, across all recalls. The rest wait in the process before sending, so
# the timeout above measures server time instead of queue time. When several processes share one endpoint, divide
# what the endpoint can serve between them.
# 默认（官方文档）：`16`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_COHERE_MAX_CONCURRENT=16
# For typesafe provider — DEPRECATED: set up the shared decision model below instead
# (HINDSIGHT_API_DECISION_MODEL_PROVIDER=typesafe), which recall uses in place of the reranker:
# **Deprecated** with the `typesafe` provider, use [`HINDSIGHT_API_DECISION_MODEL_API_KEY`](#decision-model).
# TypeSafe API key for reranking
# 默认（官方文档）：-；下一行为上游示例值。
# 安全：敏感凭证占位符；请替换并保护 .env，勿提交或公开。
# HINDSIGHT_API_RERANKER_TYPESAFE_API_KEY=your-typesafe-api-key
# **Deprecated.** TypeSafe model used to judge relevance
# 默认（官方文档）：`jev-latest`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_TYPESAFE_MODEL=jev-latest
# **Deprecated.** Base URL for the TypeSafe API
# 默认（官方文档）：`https://api.typesafe.ai`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_TYPESAFE_BASE_URL=https://api.typesafe.ai
# Ask a second question that cuts the ranked list where relevance ends, so recall
# returns the relevant candidates and nothing else. The model picks the depth; no
# threshold is tuned. Shrinks what recall returns, so it is off by default:
# **Deprecated.** Ask a second question that cuts the ranked list where relevance ends, returning only the relevant
# candidates. Shrinks what recall returns — see the note below.
# 默认（官方文档）：`false`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_TYPESAFE_PRUNE_CANDIDATES=false
# **Deprecated.** Maximum in-flight TypeSafe requests.
# 默认（官方文档）：`24`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_TYPESAFE_MAX_CONCURRENT=24
# NVIDIA NIM reranker (provider=nvidia; native /retrieval/<model>/reranking endpoint)
# NVIDIA NIM API key (`nvapi-...`) for reranking
# 默认（官方文档）：-；下一行为上游示例值。
# 安全：敏感凭证占位符；请替换并保护 .env，勿提交或公开。
# HINDSIGHT_API_RERANKER_NVIDIA_API_KEY=nvapi-your-key
# NVIDIA rerank model, with its namespace (it is part of the request path)
# 默认（官方文档）：`nvidia/llama-nemotron-rerank-vl-1b-v2`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_NVIDIA_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
# Base URL; requests go to `{base}/retrieval/{model}/reranking`
# 默认（官方文档）：`https://ai.api.nvidia.com/v1`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_NVIDIA_BASE_URL=https://ai.api.nvidia.com/v1
# HTTP request timeout for NVIDIA reranker (seconds).
# 默认（官方文档）：`60.0`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_NVIDIA_TIMEOUT=60
# Max passages per rerank request (the hosted API caps it at 512)
# 默认（官方文档）：`512`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_NVIDIA_BATCH_SIZE=512
# Max in-flight NVIDIA rerank requests
# 默认（官方文档）：`8`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_NVIDIA_MAX_CONCURRENT=8
# For flashrank provider: passages scored per ONNX forward pass. Each pass
# allocates attention tensors sized batch * heads * seq^2, so raising this
# raises peak memory quadratically in passage length:
# Passages scored per FlashRank forward pass. Each pass allocates attention tensors sized `batch × heads × seq²`, and
# FlashRank pads a batch to its longest passage, so raising this raises peak memory sharply on long candidates. Lower
# it if the reranker is the memory ceiling on a large bank.
# 默认（官方文档）：`32`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_FLASHRANK_BATCH_SIZE=32
# For onnx provider (any cross-encoder exported to ONNX, in-process, no PyTorch).
# Defaults to the HF repo's onnx/model.onnx of the local provider's model:
# Hugging Face repo for the `onnx` provider. Hindsight downloads `HINDSIGHT_API_RERANKER_ONNX_FILE` from it, and uses
# it as the tokenizer fallback.
# 默认（官方文档）：`hindsight-ai/hs-rerank-1`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_ONNX_MODEL_ID=hindsight-ai/hs-rerank-1
# ONNX file path inside the Hugging Face repo (also downloads its `_data` sidecar when present).
# 默认（官方文档）：`onnx/model.onnx`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_ONNX_FILE=onnx/model.onnx
# Or point at a model you exported yourself:
# Local path to an ONNX cross-encoder graph. Use this for models whose repo ships no ONNX file (export them yourself,
# see below).
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_ONNX_MODEL_PATH=/models/kure-reranker-nano/model.onnx
# Hugging Face tokenizer repo or local tokenizer directory. Set this with `HINDSIGHT_API_RERANKER_ONNX_MODEL_PATH`.
# 默认（官方文档）：Falls back to `HINDSIGHT_API_RERANKER_ONNX_MODEL_ID`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_ONNX_TOKENIZER_NAME_OR_PATH=/models/kure-reranker-nano
# Max tokens per (query, document) pair; longer pairs are truncated.
# 默认（官方文档）：`512`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_ONNX_MAX_TOKENS=512
# Pairs scored per forward pass. Bounds peak memory the same way as the FlashRank setting above.
# 默认（官方文档）：`32`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_ONNX_BATCH_SIZE=32        # Pairs per forward pass; bounds peak memory
# CPU threads one forward pass may use. `0` uses the native thread cap (`OMP_NUM_THREADS`, by default `min(16,
# available CPUs)`). Set `2`–`4` on a laptop to keep recall from pinning the whole CPU.
# 默认（官方文档）：`0`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_ONNX_THREADS=0            # Cores per pass; 0 = native thread cap, 2-4 on a laptop
# Forward passes allowed at once. Concurrent recalls queue behind each other, so CPU use never exceeds `THREADS`
# cores.
# 默认（官方文档）：`1`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_ONNX_MAX_CONCURRENT=1     # Passes at once; extra recalls queue
# Enable ONNX Runtime's CPU memory arena. It never returns freed memory, so RSS holds its high-water mark.
# 默认（官方文档）：`false`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_ONNX_CPU_MEM_ARENA=false  # ONNX CPU memory arena; true lets RSS ratchet up
# Wall-clock ceiling for scoring one recall's candidates, same as `HINDSIGHT_API_RERANKER_LOCAL_TIMEOUT`: on expiry
# the unscored candidates keep their pre-rerank order behind the scored ones. `0` disables.
# 默认（官方文档）：`300`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_ONNX_TIMEOUT=300          # Seconds per recall's rerank before unscored candidates keep RRF order
# Max candidates the cross-encoder reranks per recall (RRF pre-filters the rest):
# Max candidates to rerank per recall (RRF pre-filters the rest)
# 默认（官方文档）：`300`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_MAX_CANDIDATES=300
# Optionally scale that cap by the recall budget level (the cross-encoder dominates
# a large recall's latency). 0 = fall back to the flat cap above; fully backwards-compatible.
# Override the reranker candidate cap for `budget=low` recalls (the cross-encoder is the dominant cost of a large
# recall, so a lower cap trades some depth for latency). `0` falls back to `HINDSIGHT_API_RERANKER_MAX_CANDIDATES`.
# 默认（官方文档）：`0`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_MAX_CANDIDATES_LOW=0
# Override the reranker candidate cap for `budget=mid` recalls. `0` falls back to
# `HINDSIGHT_API_RERANKER_MAX_CANDIDATES`.
# 默认（官方文档）：`0`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_MAX_CANDIDATES_MID=0
# Override the reranker candidate cap for `budget=high` recalls. `0` falls back to
# `HINDSIGHT_API_RERANKER_MAX_CANDIDATES`.
# 默认（官方文档）：`0`；下一行为上游示例值。
# HINDSIGHT_API_RERANKER_MAX_CANDIDATES_HIGH=0

# =============================================================================
# Decision model (optional)
# =============================================================================
# A typed-judgment model operations use for quick decisions instead of an LLM call.
# Set up once; shared by every operation that supports one, unless it overrides or
# opts out. Replaces the deprecated typesafe reranker above.
# Reflect and page refresh support only hindsight and typesafe for now; recall
# and consolidation support all of them. See https://hindsight.vectorize.io/developer/decision-models
# hindsight is Hindsight Inference (https://inference.hindsight.vectorize.io, hs-decide-1-flash): run
# `hindsight-admin cloud login` or set the API key (hsk_...). Recall keeps its reranker
# unless HINDSIGHT_API_RECALL_DECISION_MODEL_PROVIDER=hindsight.
# `none`, `hindsight`, `typesafe`, `cloudflare` or `openai` (see below).
# 默认（官方文档）：`none`；下一行为上游示例值。
# HINDSIGHT_API_DECISION_MODEL_PROVIDER=typesafe       # none (default) | hindsight | typesafe | cloudflare | openai
# API key (Cloudflare: an API token with Workers AI access). Required when the provider is not `none`.
# 默认（官方文档）：-；下一行为上游示例值。
# 安全：敏感凭证占位符；请替换并保护 .env，勿提交或公开。
# HINDSIGHT_API_DECISION_MODEL_API_KEY=your-api-key
# Model and URL default per provider: typesafe jev-latest @ https://api.typesafe.ai,
# openai gpt-6-luna @ https://api.openai.com, cloudflare clef @ (required) your account URL:
# Model name.
# 默认（官方文档）：provider default；下一行为上游示例值。
# HINDSIGHT_API_DECISION_MODEL_MODEL=jev-latest
# API base URL. Required for `cloudflare`.
# 默认（官方文档）：provider default；下一行为上游示例值。
# HINDSIGHT_API_DECISION_MODEL_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/run
# Request timeout in seconds.
# 默认（官方文档）：`60`；下一行为上游示例值。
# HINDSIGHT_API_DECISION_MODEL_TIMEOUT=60
# Most requests in flight at once, for each operation using the decision model.
# 默认（官方文档）：`24`；下一行为上游示例值。
# HINDSIGHT_API_DECISION_MODEL_MAX_CONCURRENT=24
# Most tokens one request may carry, counted on the whole body; larger asks are split
# across requests. Follows the served model's context window (32k for jev-latest), less a margin.
# Not needed for hindsight on Hindsight Inference, which fits each request itself (no token split);
# hindsight on a custom BASE_URL (your own vLLM) splits at 54000:
# Most tokens one request may carry, counted on the whole request body. Larger asks are split across requests.
# Reflect's evidence ranking sizes each question to it too. Set it to the served model's context window less a
# margin. Only for endpoints that do not fit requests themselves: on Hindsight Inference's own URL, `hindsight` fits
# each request to its model's window, so the whole ask goes in one request (split only to stay under the 2 MB body
# limit). With a custom `HINDSIGHT_API_DECISION_MODEL_BASE_URL` (the model on your own vLLM), requests are split
# again.
# 默认（官方文档）：`26000`; `54000` for `hindsight` on a custom URL; unset on Hindsight Inference；下一行为上游示例值。
# HINDSIGHT_API_DECISION_MODEL_MAX_REQUEST_TOKENS=26000
# Show the decision model pictures (reflect's knowledge-bank pictures when it asks "is this enough?").
# System One providers only, on a model that reads images (Jev 1.13+); a preview, so off by default:
# Show the decision model pictures. Today that is reflect's knowledge-bank pictures, when it asks whether the
# evidence already answers the question; without them an answer only a picture holds reads as "not enough" and costs
# another round. System One providers only (`typesafe`, `hindsight`), on a model that reads images (Jev 1.13+). Only
# PNG and JPEG pictures 280–1568 px on each side are sent; others stay text. Off by default: images on System One are
# a preview. Server-level only.
# 默认（官方文档）：`false`；下一行为上游示例值。
# HINDSIGHT_API_DECISION_MODEL_VISION=false
# The vocabulary that ceiling and recall's caps are counted in: the served model's own (jev for typesafe, else
# HINDSIGHT_API_TOKENIZER_ENCODING). Set it when the endpoint serves another model, e.g. qwen3.5 or hs-decide-1-flash:
# The vocabulary the request ceiling, recall's caps (on the query, the shared context and each memory) and reflect's
# evidence ranking are counted in: the served model's own, since it is the model that refuses a request past its
# window. `jev` (an estimate of Jev's count), `qwen3.5` and `hs-decide-1-flash` are available besides the
# `HINDSIGHT_API_TOKENIZER_ENCODING` ones. Set it when the endpoint serves another model than the provider's default.
# 默认（官方文档）：`jev` for `typesafe`; else `HINDSIGHT_API_TOKENIZER_ENCODING`；下一行为上游示例值。
# HINDSIGHT_API_DECISION_MODEL_TOKENIZER=jev
# Recall: when it has a decision model, it replaces the reranker above. Each candidate is
# judged on whether it helps answer the question, told the question's date (else today),
# and the order is final (no recency or proof-count boosts).
# Prune: also drop the candidates it judges no help, at no extra request. Dedup: also drop
# a candidate repeating a better-ranked one, at one more request. Defaults for a recall
# request that omits `prune` / `dedup`, per bank; both off by default:
# Also drop recall candidates judged no help, instead of only ordering them (see below). Per bank
# (`recall_decision_model_prune`).
# 默认（官方文档）：`false`；下一行为上游示例值。
# HINDSIGHT_API_RECALL_DECISION_MODEL_PRUNE=false
# Also drop recall candidates repeating a better-ranked one (see below). Per bank (`recall_decision_model_dedup`).
# 默认（官方文档）：`false`；下一行为上游示例值。
# HINDSIGHT_API_RECALL_DECISION_MODEL_DEDUP=false
# Rank a recall the decision model fails with the HINDSIGHT_API_RERANKER_* reranker instead of failing it
# When the decision model fails or refuses a recall's ranking after its retries, rank that recall with the configured
# `HINDSIGHT_API_RERANKER_*` reranker (failover chain included) instead of failing it. Off, the recall fails, so you
# see the outage instead of quietly worse results. Server-wide.
# 默认（官方文档）：`false`；下一行为上游示例值。
# HINDSIGHT_API_RECALL_DECISION_MODEL_FALLBACK=false
# Per-operation overrides (fall back to the global value while on the global provider;
# 官方 v1.3.0 示例：PROVIDER；下一行为示例，不声明为默认值。参见本组上方原文说明。
# PROVIDER=none opts out):
# HINDSIGHT_API_{RECALL,REFLECT,CONSOLIDATION}_DECISION_MODEL_{PROVIDER,API_KEY,MODEL,BASE_URL}
# 官方 v1.3.0 示例：HINDSIGHT_API_REFLECT_DECISION_MODEL_MODEL；下一行为示例，不声明为默认值。参见本组上方原文说明。
# HINDSIGHT_API_REFLECT_DECISION_MODEL_MODEL=jev-preview

# Reranker failover chain: extra rerankers tried, in order, when the one above
# fails. Members are numbered from 1 (indices must be contiguous) and every
# setting of member n carries the same index. A member inherits nothing from the
# primary, so spell out everything it needs. Unset = no fallback (default): a
# failing reranker fails the recall. End the chain with "rrf" to fail open and
# keep the retrieval order instead.
# 官方 v1.3.0 示例：HINDSIGHT_API_RERANKER_1_PROVIDER；下一行为示例，不声明为默认值。参见本组上方原文说明。
# HINDSIGHT_API_RERANKER_1_PROVIDER=cohere
# 官方 v1.3.0 示例：HINDSIGHT_API_RERANKER_1_COHERE_API_KEY；下一行为示例，不声明为默认值。参见本组上方原文说明。
# 安全：敏感凭证占位符；请替换并保护 .env，勿提交或公开。
# HINDSIGHT_API_RERANKER_1_COHERE_API_KEY=your-cohere-api-key
# 官方 v1.3.0 示例：HINDSIGHT_API_RERANKER_2_PROVIDER；下一行为示例，不声明为默认值。参见本组上方原文说明。
# HINDSIGHT_API_RERANKER_2_PROVIDER=rrf

# Observability & Tracing (Optional - disabled by default)
# Enable OpenTelemetry tracing for LLM calls (GenAI semantic conventions)
# Enable distributed tracing for LLM calls
# 默认（官方文档）：`false`；下一行为上游示例值。
# HINDSIGHT_API_OTEL_TRACES_ENABLED=true
#
# Local development with Grafana LGTM stack (recommended - see scripts/dev/grafana/README.md)
# OTLP endpoint URL (e.g., Grafana LGTM, Langfuse, etc.)
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#
# Cloud backends (Grafana Cloud, Langfuse, DataDog, etc.)
# OTLP endpoint URL (e.g., Grafana LGTM, Langfuse, etc.)
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_OTEL_EXPORTER_OTLP_ENDPOINT=https://your-backend-url
# Headers for OTLP exporter (format: "key1=value1,key2=value2")
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer your-token"
#
# Custom service name and environment (optional, defaults: hindsight-api, development)
# Service name for traces. Applies to the API and to standalone workers, which default to `hindsight-worker` when it
# is unset.
# 默认（官方文档）：`hindsight-api`；下一行为上游示例值。
# HINDSIGHT_API_OTEL_SERVICE_NAME=hindsight-production
# Deployment environment name (e.g., development, staging, production)
# 默认（官方文档）：`development`；下一行为上游示例值。
# HINDSIGHT_API_OTEL_DEPLOYMENT_ENVIRONMENT=production
#
# Expose async-operation queue + consolidation-backlog gauges on /metrics.
# Runs periodic per-schema COUNT queries on a background task (disabled by default).
# Expose async-operation queue depth and consolidation-backlog gauges (`hindsight_async_operations`,
# `hindsight_consolidation_backlog`, `hindsight_consolidation_failed`). Runs periodic per-schema `COUNT` queries on a
# background task.
# 默认（官方文档）：`false`；下一行为上游示例值。
# HINDSIGHT_API_METRICS_BACKLOG_ENABLED=true
#
# Include a per-tenant (schema) label on OTel metrics. High-cardinality on
# deployments with many tenants (one series set per schema, multiplied through
# every histogram bucket), so disabled by default; enable only for small
# deployments (mirrors HINDSIGHT_API_METRICS_INCLUDE_BANK_ID).
# Include a per-tenant (`tenant`, the schema) label on OTel metrics. Enable only for deployments with few tenants —
# one series set per tenant, multiplied through every histogram bucket, causes unbounded memory growth.
# 默认（官方文档）：`false`；下一行为上游示例值。
# HINDSIGHT_API_METRICS_INCLUDE_TENANT=true
#
# Runtime-stall observability (enabled by default). When a liveness probe fails,
# these tell you WHY: a blocked event loop vs DB connection-pool exhaustion.
# The loop watchdog logs the offending stack when the loop is unresponsive; the
# DB-pool acquire timing logs (and exposes hindsight.db.pool.waiting) when
# callers queue for a connection. Both are cheap; tune or disable if needed.
# Run a background thread that detects event-loop stalls and logs the blocking stack. Also emits
# `hindsight_event_loop_stalls` / `hindsight_event_loop_stall_duration`.
# 默认（官方文档）：`true`；下一行为上游示例值。
# HINDSIGHT_API_LOOP_WATCHDOG_ENABLED=false
# Log a stall once the loop is unresponsive for at least this long.
# 默认（官方文档）：`1000`；下一行为上游示例值。
# HINDSIGHT_API_LOOP_WATCHDOG_STALL_THRESHOLD_MS=1000
# How often the watchdog thread pings the loop.
# 默认（官方文档）：`250`；下一行为上游示例值。
# HINDSIGHT_API_LOOP_WATCHDOG_POLL_INTERVAL_MS=250
# Log a warning (with pool stats) when acquiring a pooled connection waits at least this long.
# 默认（官方文档）：`1000`；下一行为上游示例值。
# HINDSIGHT_API_DB_ACQUIRE_WARN_THRESHOLD_MS=1000
#
# Per-bank model call log (the control plane's "LLM Requests" tab). Records every
# LLM, embedding, reranker and decision-model call; rows are buffered and written
# in batches, so a crash can lose the last ~0.5s of rows.
# Master switch for LLM request tracing. Must be `true` for any calls to be recorded.
# 默认（官方文档）：`true`；下一行为上游示例值。
# HINDSIGHT_API_LLM_TRACE_ENABLED=false             # default: true
# Comma-separated allowlist of call scopes to trace (e.g. `retain_extract_facts,reflect`; empty = all scopes). An
# entry ending in `*` matches a prefix (`decision_*`).
# 默认（官方文档）：`""`；下一行为上游示例值。
# HINDSIGHT_API_LLM_TRACE_SCOPES=retain_extract_facts,reflect   # only these scopes (default: all)
# Comma-separated call scopes never to trace, applied after the allowlist; `*` prefix patterns as above (e.g.
# `embedding_*,rerank` keeps only LLM and decision-model calls).
# 默认（官方文档）：`""`；下一行为上游示例值。
# HINDSIGHT_API_LLM_TRACE_EXCLUDE_SCOPES=embedding_*,rerank    # never these; wins over SCOPES; * matches a prefix
# Number of days to retain trace rows. `-1` = keep forever. LLM request lists and stats (including the 7d/30d
# periods) only cover this window; both responses return it as `retention_days`.
# 默认（官方文档）：`1`；下一行为上游示例值。
# HINDSIGHT_API_LLM_TRACE_RETENTION_DAYS=1          # -1 keeps rows forever
# Truncate stored input/output beyond this many characters (keeps the row, stores a truncated preview).
# 默认（官方文档）：`50000`；下一行为上游示例值。
# HINDSIGHT_API_LLM_TRACE_MAX_CHARS=50000           # truncate stored input/output
# Deleting a document also deletes the trace rows that quote it: its retain runs, and every run that created or
# consumed one of its memories (consolidation included). Off, they stay until the retention sweep removes them. Rows
# the API server is still holding are written out first, so a retain followed straight away by a delete leaves
# nothing behind. Calls still running in a worker when the delete lands (a background retain, a consolidation) can
# still be written afterwards; the retention sweep removes those.
# 默认（官方文档）：`false`；下一行为上游示例值。
# HINDSIGHT_API_LLM_TRACE_DELETE_WITH_DOCUMENT=true # deleting a document deletes its trace rows (default: false)

# -----------------------------------------------------------------------------
# Knowledge banks (on by default)
# -----------------------------------------------------------------------------

# Turn knowledge banks off: their endpoints answer 404, reflect ignores linked knowledge banks
# and the control plane hides them
# Knowledge banks on or off. Off, their HTTP routes answer 404, reflect ignores linked knowledge banks and the
# control plane hides them.
# 默认（官方文档）：`true`；下一行为上游示例值。
# HINDSIGHT_API_ENABLE_KB=true
# The one embedder for every knowledge bank: local, gemini, vertex, voyage, cohere, openai or text
# The one embedder for every knowledge bank; what it embeds decides which media types can be ingested. `local`
# (EmbeddingGemma 2 in-process: text, image, audio, video), `gemini` / `vertex` (Gemini Embedding 2), `voyage` (text,
# image, video), `cohere` (text, image), `openai` (any OpenAI-compatible `/v1/embeddings` server), `text` (a
# memory-bank embeddings provider, text only).
# 默认（官方文档）：`local`；下一行为上游示例值。
# HINDSIGHT_API_KB_EMBEDDINGS_PROVIDER=local
# Model (unset: the provider's own), key, and /v1 URL (openai: required)
# The model. Unset uses the provider's: `google/embeddinggemma-2`, `gemini-embedding-2`, `voyage-multimodal-3.5`,
# `embed-v4.0`. Required for `openai`.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_KB_EMBEDDINGS_MODEL=
# API key for the remote providers.
# 默认（官方文档）：-；下一行为上游示例值。
# 安全：敏感凭证占位符；请替换并保护 .env，勿提交或公开。
# HINDSIGHT_API_KB_EMBEDDINGS_API_KEY=
# Server URL: the `/v1` URL for `openai` (required), or a proxy for `voyage` / `cohere`.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_KB_EMBEDDINGS_BASE_URL=
# Vector size for a model that can shorten them (unset: the model's own)
# Vector size, for a model that can shorten its vectors. Unset keeps the model's own.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_KB_EMBEDDINGS_DIMENSIONS=
# openai provider: what the remote model embeds
# For `openai`: what the remote model embeds, comma-separated (`text`, `image`, `audio`, `video`).
# 默认（官方文档）：`text,image`；下一行为上游示例值。
# HINDSIGHT_API_KB_EMBEDDINGS_MODALITIES=text,image
# local provider: torch device (cpu, cuda, mps; unset picks one)
# For `local`: the torch device (`cpu`, `cuda`, `mps`). Unset picks one.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_KB_EMBEDDINGS_DEVICE=
# Passages per embedder request, and remote requests in flight per process (0 = no cap)
# Passages per embedder request.
# 默认（官方文档）：`32`；下一行为上游示例值。
# HINDSIGHT_API_KB_EMBEDDINGS_BATCH_SIZE=32
# Requests to a remote embedder in flight at once from this process, across every ingest and search. `0` removes the
# cap.
# 默认（官方文档）：`16`；下一行为上游示例值。
# HINDSIGHT_API_KB_EMBEDDINGS_MAX_IN_FLIGHT=16
# text provider: its own embeddings setup, any HINDSIGHT_API_EMBEDDINGS_* with this prefix
# 官方 v1.3.0 示例：HINDSIGHT_API_KB_TEXT_EMBEDDINGS_PROVIDER；下一行为示例，不声明为默认值。参见本组上方原文说明。
# HINDSIGHT_API_KB_TEXT_EMBEDDINGS_PROVIDER=
# Knowledge-bank search's reranker: any Cohere-style /rerank endpoint (full URL; unset: no rerank).
# The best hits go in one request, as many as MAX_TOKENS holds (a low search budget: at most 26000),
# counted with TOKENIZER (unset: HINDSIGHT_API_TOKENIZER_ENCODING); videos keep their search place.
# IMAGES sends image and PDF page hits as pictures with their text (false: a text-only reranker).
# MAX_TOKENS is sized for a long-window reranker: lower it to your reranker's window.
# Rerank knowledge-bank search hits with any reranker speaking Cohere's rerank API (`{model, query, documents}` in,
# `{results: [{index, relevance_score}]}` out), at this full URL (e.g. `https://api.cohere.com/v2/rerank`). The best
# hits go in one request, in search order, as many as `HINDSIGHT_API_KB_RERANKER_MAX_TOKENS` holds; its scores
# reorder them, ties keeping the search's order, and the rest keep the search's order. A text hit is sent with the
# text around it (up to 2048 tokens); a video hit is not sent and keeps its search place; a search with neither text
# nor an image query is not reranked, and a search by a video is reranked by its text only (never by the clip).
# Reflect's search of the knowledge banks a memory bank links is reranked too; when the reranker is down, that bank's
# results are left out of the reflect. One search can skip it with `"enable_reranking": false` in the search request,
# or ask for it with `true` when `HINDSIGHT_API_KB_ENABLE_RERANKING` is off. Unset: no rerank.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_KB_RERANKER_URL=
# The reranker's model. Required with the URL.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_KB_RERANKER_MODEL=
# Its API key, sent as a bearer token.
# 默认（官方文档）：-；下一行为上游示例值。
# 安全：敏感凭证占位符；请替换并保护 .env，勿提交或公开。
# HINDSIGHT_API_KB_RERANKER_API_KEY=
# Tokens of hits one rerank request holds on a `mid` or `high` search budget, which is how deep the rerank goes; a
# `low` budget holds at most 26,000. Sized for a reranker with a long window; lower it to your reranker's window, or
# it splits or refuses what it is sent.
# 默认（官方文档）：`120000`；下一行为上游示例值。
# HINDSIGHT_API_KB_RERANKER_MAX_TOKENS=120000
# The encoding the reranker counts its window in. Unset uses `HINDSIGHT_API_TOKENIZER_ENCODING`.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_KB_RERANKER_TOKENIZER=
# Send image and PDF page hits as pictures, each an image document `{"type": "image", "b64": <base64 JPEG>, "text":
# <its text>}`. A picture under 280 or over 1568 px a side is sent as its text. Set `false` for a reranker that reads
# no images: every hit then goes as its text.
# 默认（官方文档）：`true`；下一行为上游示例值。
# HINDSIGHT_API_KB_RERANKER_IMAGES=true
# Also send the picture of a search by an image (`query_image`, not with a video) as the query, with or without text.
# `query` is then an image object `{"type": "image", "b64": <base64 JPEG>, "text": <the query text, left out when
# empty>}` instead of a string, and a search with an image and no text is reranked too. A query picture under 280 px
# on its short side is enlarged to 280 (aspect kept); one that cannot fit 280-1568 px a side that way (an extreme
# strip) is left out. **The reranker must accept an image query before this is turned on**: one that takes image
# documents but only a string query would fail every search that has an image. Takes effect only with
# `HINDSIGHT_API_KB_RERANKER_IMAGES` on. Off: the query goes as its text, and a search with no text is not reranked.
# 默认（官方文档）：`false`；下一行为上游示例值。
# HINDSIGHT_API_KB_RERANKER_QUERY_IMAGES=false
# Rerank searches that leave enable_reranking unset (false: only an explicit true reranks)
# Whether a search that leaves `enable_reranking` unset is reranked. `false`: the reranker stays set up, but only a
# search sending `"enable_reranking": true` uses it. A search's own `enable_reranking` always wins.
# 默认（官方文档）：`true`；下一行为上游示例值。
# HINDSIGHT_API_KB_ENABLE_RERANKING=true
# Ingest limits (the per-bank ones can be narrowed per knowledge bank)
# Media types refused at ingest, comma-separated (`document`, `image`, `audio`, `video`, `text`). *Per bank* (a bank
# can only add to it).
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_KB_DISABLED_MEDIA_TYPES=
# Largest file accepted. Server-only. A file is never held whole in memory: uploads are read from disk and stored in
# pieces, and the worker cuts a local copy.
# 默认（官方文档）：`500`；下一行为上游示例值。
# HINDSIGHT_API_KB_MAX_FILE_MB=500
# Per media type, in place of `HINDSIGHT_API_KB_MAX_FILE_MB`: `<type>=<MB>` pairs, comma-separated (`document`,
# `image`, `audio`, `video`, `text`), e.g. `video=2000,image=50,text=100`. A type not listed uses the global limit.
# Server-only. Set `document` when Office files are accepted: a spreadsheet converts at about 100× its size in memory
# (a 27 MB `.xls` took 3.2 GB), one at a time per server.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_KB_MAX_FILE_MB_BY_MEDIA_TYPE=   # per media type, e.g. video=2000,image=50,text=100
# Largest image, in megapixels, checked from its header before decoding: decoding costs memory by pixels (about 3–4
# bytes each), and a few-MB PNG can declare 30000×30000. Covers HEIC too. Server-only.
# 默认（官方文档）：`178`；下一行为上游示例值。
# HINDSIGHT_API_KB_MAX_IMAGE_MEGAPIXELS=178    # largest image, checked before decoding
# Most memory one worker process converting an Office file or rendering a PDF may take, in MB (its address space;
# about 0.9 GB of it at rest). Past it that file fails and the server carries on: a 42 KB spreadsheet can declare
# 16.7 million cells and grow its converter until the container runs out, and on Kubernetes that kills the server
# with it. `0` sizes it from the machine: half the container's memory limit (or of the RAM) plus 1 GB. Server-only.
# 默认（官方文档）：`0`；下一行为上游示例值。
# HINDSIGHT_API_KB_WORKER_MEMORY_MB=0          # most memory an Office/PDF worker may take; 0 = half the container + 1 GB
# Longest audio or video file. *Per bank*.
# 默认（官方文档）：`7200`；下一行为上游示例值。
# HINDSIGHT_API_KB_MAX_MEDIA_SECONDS=7200
# Most work one video may take to cut, in seconds of 1080p 30 fps video: cutting costs CPU by frames and their
# pixels, not by length or file size, so 4K at 60 fps counts about 3× per second and a file without a seek index
# (decoded from its start for every passage) far more. Checked from the header before decoding, and counted again
# while decoding. `0` turns it off. Server-only.
# 默认（官方文档）：`7200`；下一行为上游示例值。
# HINDSIGHT_API_KB_MAX_VIDEO_WORK_SECONDS=7200    # most work one video may take to cut, in seconds of 1080p 30 fps
# Most pages in one PDF. *Per bank*.
# 默认（官方文档）：`2000`；下一行为上游示例值。
# HINDSIGHT_API_KB_MAX_PDF_PAGES=2000
# How files are split into passages (per bank)
# Size of a text passage, in tokens; passages follow the document's structure. *Per bank*.
# 默认（官方文档）：`512`；下一行为上游示例值。
# HINDSIGHT_API_KB_TEXT_PASSAGE_TOKENS=512
# Vision tokens per image for the `local` embedder (70–1120). *Per bank*.
# 默认（官方文档）：`280`；下一行为上游示例值。
# HINDSIGHT_API_KB_IMAGE_TOKENS=280
# Longest side of a rendered PDF page, in pixels. *Per bank*.
# 默认（官方文档）：`1536`；下一行为上游示例值。
# HINDSIGHT_API_KB_PDF_PAGE_PIXELS=1536
# Also embed three horizontal bands of each PDF page: better search, half the ingest speed. *Per bank*.
# 默认（官方文档）：`false`；下一行为上游示例值。
# HINDSIGHT_API_KB_PDF_BANDS=false
# Length of one audio passage. *Per bank*.
# 默认（官方文档）：`60`；下一行为上游示例值。
# HINDSIGHT_API_KB_AUDIO_WINDOW_SECONDS=60
# Length of one video passage. *Per bank*.
# 默认（官方文档）：`30`；下一行为上游示例值。
# HINDSIGHT_API_KB_VIDEO_WINDOW_SECONDS=30
# Overlap between consecutive audio or video passages, at most half of each passage length (more is cut at half).
# *Per bank*.
# 默认（官方文档）：`5`；下一行为上游示例值。
# HINDSIGHT_API_KB_MEDIA_OVERLAP_SECONDS=5
# Search weights: PDF text vs page image, and keyword matches
# Search: a PDF page's score is `(1 - w)` × its image score + `w` × its best text score.
# 默认（官方文档）：`0.7`；下一行为上游示例值。
# HINDSIGHT_API_KB_PDF_TEXT_WEIGHT=0.7
# Search: weight of the keyword match, fused in for a query with a word rare enough in the bank.
# 默认（官方文档）：`0.2`；下一行为上游示例值。
# HINDSIGHT_API_KB_KEYWORD_WEIGHT=0.2
# Async ingest: worker task size in bytes, and memory one batch may hold (0 = off)
# An async ingest is split into worker tasks of about this many bytes of files, so a big upload spreads across
# workers.
# 默认（官方文档）：`1048576`；下一行为上游示例值。
# HINDSIGHT_API_KB_INGEST_CHILD_BYTES=1048576
# Memory one ingest batch may hold before it commits what it has. `0` turns it off.
# 默认（官方文档）：`128`；下一行为上游示例值。
# HINDSIGHT_API_KB_INGEST_MEMORY_BUDGET_MB=128
# Named ingest strategies (JSON) and the default one
# Named ingest strategies, as JSON: `{name: {file_type: {"extension": "module:Class", "settings": {...}}}}`, the
# extension that pre-processes each file type.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_KB_INGEST_STRATEGIES=
# The strategy an ingest uses unless its item names another.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_KB_INGEST_DEFAULT_STRATEGY=
# Where documents and passages live (module.path:ClassName; unset: PostgreSQL)
# Where documents and passages live: `module.path:ClassName` of a `KnowledgeStore`. Unset uses PostgreSQL.
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_KB_STORE_EXTENSION=

# -----------------------------------------------------------------------------
# Operations (Optional)
# -----------------------------------------------------------------------------

# Where `--daemon` redirects the server's stdout/stderr. Set this per profile when
# several daemons share a machine, so their output does not interleave.
# Where `--daemon` redirects the server's stdout and stderr. Set this per profile when several daemons run on one
# machine, so their output does not interleave into a single file.
# 默认（官方文档）：`~/.hindsight/daemon.log`；下一行为上游示例值。
# HINDSIGHT_API_DAEMON_LOG=~/.hindsight/daemon.log

# Periodic CPU profile, as JSON. Absent = profiling off.
# JSON object; unset disables profiling entirely. `{"every": 60, "top": 20}`
# 默认（官方文档）：unset；下一行为上游示例值。
# HINDSIGHT_API_PROFILE='{"every": 60, "top": 20, "mode": "cprofile"}'

# How long a task the store shed for backpressure is held before being retried.
# Deferrals do not count against HINDSIGHT_API_WORKER_MAX_RETRIES.
# How long a task the store shed for backpressure is held before it is retried. Long enough that the backlog has a
# real chance to drain — retrying into a still-full store just sheds again — and short enough that a cleared backlog
# is not left waiting. Deferrals do not count against `HINDSIGHT_API_WORKER_MAX_RETRIES`, for any task type; after
# 180 of them the task fails, since a store that has refused it that long is stuck, not busy.
# 默认（官方文档）：`120`；下一行为上游示例值。
# HINDSIGHT_API_BACKPRESSURE_DEFER_SECONDS=120

# Seconds shutdown waits for in-flight tasks, counted from SIGTERM, before cancelling
# them and handing them back to 'pending'. Keep it ~10s under the platform's grace period.
# On SIGTERM a worker (the API's embedded one included) stops claiming at once, then waits this long for in-flight
# tasks before cancelling them and handing them back to `pending` for another worker. Counted from the signal. Cancel
# and hand-back take about 7s more, so keep it about 10s under the platform's grace period
# (`terminationGracePeriodSeconds`, Docker's `stop_grace_period`); the default fits Kubernetes' default 30s. A task
# handed back is retried from the start.
# 默认（官方文档）：`20`；下一行为上游示例值。
# HINDSIGHT_API_WORKER_SHUTDOWN_DRAIN_SECONDS=20

# Legacy MCP bearer token, checked before the TenantExtension's own auth.
# Bearer token for MCP authentication (optional)
# 默认（官方文档）：-；下一行为上游示例值。
# 安全：敏感凭证占位符；请替换并保护 .env，勿提交或公开。
# HINDSIGHT_API_MCP_AUTH_TOKEN=your-mcp-token

# Instructions sent to MCP clients when they connect to a single-bank endpoint
# (/mcp/{bank_id}/). Hierarchical: usually set per bank as mcp_server_instructions.
# Instructions sent to MCP clients in the `initialize` response when they connect to a single-bank endpoint
# (`/mcp/{bank_id}/`). At most 4,000 characters. Hierarchical — usually set per bank via the [config
# API](#hierarchical-configuration) as `mcp_server_instructions`. See [Per-bank server
# instructions](./mcp-server.md#per-bank-server-instructions).
# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_MCP_SERVER_INSTRUCTIONS=

# -----------------------------------------------------------------------------
# SuperGrok OAuth provider (Optional; HINDSIGHT_API_LLM_PROVIDER=xai-oauth)
# -----------------------------------------------------------------------------

# All optional — the defaults match the vendor's own client. Log in once with
# `python -m hindsight_api.engine.providers.xai_oauth_auth login`.
# Where the OAuth grant is stored. Both the login and the refresh follow it, so this relocates the store rather than
# overriding only the read.
# 默认（官方文档）：`~/.hindsight/xai_oauth.json`；下一行为上游示例值。
# 安全：敏感凭证占位符；请替换并保护 .env，勿提交或公开。
# HINDSIGHT_API_XAI_OAUTH_TOKEN_PATH=~/.hindsight/xai_oauth.json
# Deployment-wide endpoint override. Takes precedence over `HINDSIGHT_API_LLM_BASE_URL`, which deployments often set
# for an unrelated proxy.
# 默认（官方文档）：`https://api.x.ai/v1`；下一行为上游示例值。
# HINDSIGHT_API_XAI_OAUTH_BASE_URL=https://api.x.ai/v1
# OAuth client id used at login and refresh.
# 默认（官方文档）：xAI's published Grok CLI client；下一行为上游示例值。
# 安全：敏感凭证占位符；请替换并保护 .env，勿提交或公开。
# HINDSIGHT_API_XAI_OAUTH_CLIENT_ID=your-oauth-client-id
# Scope string requested at login.
# 默认（官方文档）：vendor default；下一行为上游示例值。
# HINDSIGHT_API_XAI_OAUTH_SCOPE=openid profile email offline_access
# How long before expiry a token counts as due for refresh. Widen it if this deployment calls the provider rarely (a
# cron or gateway shape).
# 默认（官方文档）：`60`；下一行为上游示例值。
# HINDSIGHT_API_XAI_OAUTH_REFRESH_SKEW_SECONDS=60
# Per-request timeout for discovery, device-code and refresh calls.
# 默认（官方文档）：`20`；下一行为上游示例值。
# HINDSIGHT_API_XAI_OAUTH_REFRESH_TIMEOUT_SECONDS=20
# Debug-only: logs an allowlist of response headers on a non-2xx reply.
# Log an allowlist of response headers (`via`, `x-request-id`, `cf-ray`, `server`, `date`) on a non-2xx reply.
# Diagnostic only; never logs credentials, cookies or bodies.
# 默认（官方文档）：`false`；下一行为上游示例值。
# HINDSIGHT_API_XAI_OAUTH_DEBUG_HEADERS=false

# -----------------------------------------------------------------------------
# Extensions (Optional)
# -----------------------------------------------------------------------------

# Your own FileStorage implementation, used instead of the built-in backends.
# Every other HINDSIGHT_API_FILE_STORAGE_* variable is passed to it as config.
# `module.path:ClassName` naming your own `FileStorage` implementation, used instead of the built-in backends. Every
# other `HINDSIGHT_API_FILE_STORAGE_*` variable is passed to it as a lowercased config dict. Implement
# `delete_prefix` too, or deleting a bank leaves that bank's stored files in your backend.
# 默认（官方文档）：unset；下一行为上游示例值。
# HINDSIGHT_API_FILE_STORAGE_EXTENSION=my_package.storage:MyStorage

# Request headers copied into RequestContext.extra_headers so a custom
# TenantExtension / OperationValidatorExtension can read them. Comma-separated,
# matched case-insensitively. Unset by default: extensions see only the
# Authorization header. Use this when the bearer token identifies a proxy rather
# than the caller, and per-caller identity arrives in a separate header. A listed
# header that arrives more than once is dropped, so only list headers the proxy
# in front of Hindsight sets itself (stripping any client-supplied copy).
# Comma-separated request headers copied into `RequestContext.extra_headers` for extensions to read, matched
# case-insensitively. Empty means extensions see only the `Authorization` header.
# 默认（官方文档）：*(none)*；下一行为上游示例值。
# HINDSIGHT_API_EXTENSION_PASSTHROUGH_HEADERS=x-user-assertion

# -----------------------------------------------------------------------------
# Bank Aliases (Optional)
# -----------------------------------------------------------------------------

# A bank alias is an extra id a bank answers to, so callers can be moved onto a
# new id without downtime. Resolving it happens on every bank-scoped request and
# is cached per (schema, alias) — misses included, since most requests name a
# real bank. The TTL is therefore how long a newly added alias stays invisible,
# and a removed one keeps routing, on API replicas other than the one that
# changed it. 0 disables the cache and resolves against the database every time.
# Time-to-live (seconds) for a resolved alias. `0` disables the cache and resolves against the database on every
# request.
# 默认（官方文档）：`10`；下一行为上游示例值。
# HINDSIGHT_API_BANK_ALIAS_CACHE_TTL_SECONDS=10

# Maximum cached (schema, alias) entries before LRU eviction.
# Maximum number of cached `(schema, alias)` entries before LRU eviction.
# 默认（官方文档）：`2048`；下一行为上游示例值。
# HINDSIGHT_API_BANK_ALIAS_CACHE_MAX_ENTRIES=2048

# -----------------------------------------------------------------------------
# Webhooks (Optional)
# -----------------------------------------------------------------------------

# Outbound webhook delivery targets caller-supplied URLs. To prevent SSRF, the
# delivery worker blocks private, loopback, and link-local destinations
# (including the cloud metadata address 169.254.169.254) by default. List hosts
# or IP/CIDR ranges here (comma-separated) to re-permit specific internal
# destinations — e.g. 127.0.0.1 for local testing, or an internal receiver.
# Comma-separated hosts or IP/CIDR ranges permitted as webhook destinations in addition to public addresses. Private,
# loopback, and link-local ranges (including the cloud metadata address) are blocked unless listed here.
# 默认（官方文档）：- (public only)；下一行为上游示例值。
# HINDSIGHT_API_WEBHOOK_ALLOWED_HOSTS=127.0.0.1,internal-receiver.svc,10.0.0.0/8

# Whether the webhook delivery-history API returns the raw upstream response
# body. Off by default: returning arbitrary response bodies to callers is an
# information-exfiltration primitive. The delivery status code is always
# returned regardless. Enable only if you trust your webhook destinations.
# Return the raw upstream response body in the delivery-history API. Off by default to avoid exposing internal
# response contents; the delivery status code is always returned.
# 默认（官方文档）：`false`；下一行为上游示例值。
# HINDSIGHT_API_WEBHOOK_EXPOSE_RESPONSE_BODY=false

# -----------------------------------------------------------------------------
# Control Plane (Optional)
# -----------------------------------------------------------------------------

# Dataplane API URL - where the CP proxies requests to
# URL of the API service
# 默认（官方文档）：`http://localhost:8888`；下一行为上游示例值。
# HINDSIGHT_CP_DATAPLANE_API_URL=http://localhost:8888

# Optional: Bearer token the CP sends as `Authorization: Bearer <key>` to the
# dataplane API. Required when the API service is auth-protected; omit for a
# public/unauthenticated API.
# Bearer token the Control Plane sends as `Authorization: Bearer <key>` on every request to the API service. Required
# when the API service is auth-protected; omit for a public API.
# 默认（官方文档）：*(none — no `Authorization` header sent)*；下一行为上游示例值。
# 安全：敏感凭证占位符；请替换并保护 .env，勿提交或公开。
# HINDSIGHT_CP_DATAPLANE_API_KEY=your-dataplane-bearer-token

# Optional: Require a shared access key to view the Control Plane UI.
# When set, visitors see a login page and must enter the key before
# accessing the dashboard or any /api/* routes (except /api/health).
# Access key to protect the Control Plane UI. When set, users must enter this key to log in.
# 默认（官方文档）：*(none — auth disabled)*；下一行为上游示例值。
# 安全：敏感凭证占位符；请替换并保护 .env，勿提交或公开。
# HINDSIGHT_CP_ACCESS_KEY=your-shared-secret-key

# =============================================================================
# 官方文档补充 / Database
# =============================================================================
# Run database migrations on API startup
# 默认（官方文档）：`true`
# HINDSIGHT_API_RUN_MIGRATIONS_ON_STARTUP=true
# Database engine backend: `postgresql` or `oracle` (Oracle 23ai)
# 默认（官方文档）：`postgresql`
# HINDSIGHT_API_DATABASE_BACKEND=postgresql

# =============================================================================
# 官方文档补充 / Database Connection Pool
# =============================================================================
# Minimum connections in the primary pool. The pool keeps this many open even when idle and replaces any that close;
# `0` lets it drain when idle.
# 默认（官方文档）：`5`
# HINDSIGHT_API_DB_POOL_MIN_SIZE=5
# Maximum connections in the primary pool
# 默认（官方文档）：`100`
# HINDSIGHT_API_DB_POOL_MAX_SIZE=100
# Minimum connections in the read-replica pool (only used when `READ_DATABASE_URL` is set). Kept open when idle, like
# `DB_POOL_MIN_SIZE`.
# 默认（官方文档）：Falls back to `DB_POOL_MIN_SIZE`
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_READ_DB_POOL_MIN_SIZE=
# Maximum connections in the read-replica pool (only used when `READ_DATABASE_URL` is set)
# 默认（官方文档）：Falls back to `DB_POOL_MAX_SIZE`
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_READ_DB_POOL_MAX_SIZE=
# PostgreSQL command timeout in seconds (asyncpg client-side)
# 默认（官方文档）：`60`
# HINDSIGHT_API_DB_COMMAND_TIMEOUT=60
# Connection acquisition timeout in seconds. Bounds how long a caller waits for a free pool connection before failing
# (retried by the caller); `0` waits indefinitely.
# 默认（官方文档）：`30`
# HINDSIGHT_API_DB_ACQUIRE_TIMEOUT=30
# Postgres `statement_timeout` applied to every pool connection, in seconds. Server-side safety net for runaway
# queries. Does **not** apply to Alembic migrations (which run on a separate psycopg2 engine). Set to `0` to disable.
# 默认（官方文档）：`600`
# HINDSIGHT_API_DB_STATEMENT_TIMEOUT=600

# =============================================================================
# 官方文档补充 / Text Search Extension
# =============================================================================
# When set, forces every LLM-generated artifact (retain facts, consolidation observations, reflect responses) into
# this language. Free-form (e.g. `Spanish`, `Japanese`).
# 默认（官方文档）：unset
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_LLM_OUTPUT_LANGUAGE=

# =============================================================================
# 官方文档补充 / LLM Provider
# =============================================================================
# Max concurrent LLM requests. When the cap is full, live API requests get the next free slot ahead of background
# jobs (async retain, consolidation) run by the in-process worker. Waiting requests take turns by tenant, then by
# bank, and inside a bank the document closest to done goes first, so one large document cannot hold every slot while
# other banks wait.
# 默认（官方文档）：`32`
# HINDSIGHT_API_LLM_MAX_CONCURRENT=32
# Max retry attempts for LLM API calls
# 默认（官方文档）：`3`
# HINDSIGHT_API_LLM_MAX_RETRIES=3
# Initial retry backoff in seconds (exponential backoff)
# 默认（官方文档）：`1.0`
# HINDSIGHT_API_LLM_INITIAL_BACKOFF=1.0
# Max retry backoff cap in seconds
# 默认（官方文档）：`60.0`
# HINDSIGHT_API_LLM_MAX_BACKOFF=60.0
# LLM request timeout in seconds. Honoured by every provider as a **total** deadline for one request, including the
# time spent reading a streamed response — a backend that keeps sending bytes is cut off at the deadline rather than
# read indefinitely. Raise it if your provider is legitimately slow; the per-operation variables below override it.
# 默认（官方文档）：`120`
# HINDSIGHT_API_LLM_TIMEOUT=120
# Tag outbound LLM and embedding calls with `user=<bank_id>` so gateways (OpenRouter usage accounting, LiteLLM,
# Helicone) can attribute spend per bank. When enabled, the bank id is transmitted to the upstream provider as the
# end-user identifier.
# 默认（官方文档）：`false`
# HINDSIGHT_API_LLM_SEND_BANK_AS_USER=false
# Groq service tier: `on_demand`, `flex`, `auto`
# 默认（官方文档）：`auto`
# HINDSIGHT_API_LLM_GROQ_SERVICE_TIER=auto
# OpenAI service tier: `flex` for 50% cost savings (OpenAI Flex Processing)
# 默认（官方文档）：None (default)
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_LLM_OPENAI_SERVICE_TIER=
# Bedrock service tier: `flex` for 50% cost savings (best-effort inference), `priority` (guaranteed throughput), or
# `reserved` (provisioned capacity)
# 默认（官方文档）：Unset (default tier)
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_LLM_BEDROCK_SERVICE_TIER=
# Gemini service tier: `flex` for 50% cost savings (best-effort inference)
# 默认（官方文档）：Unset (default tier)
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_LLM_GEMINI_SERVICE_TIER=
# JSON dict of extra request-body params (e.g. `temperature`, `top_p`, `max_tokens`) merged into every LLM call.
# Applied across the OpenAI-compatible, Fireworks, Anthropic, Gemini/VertexAI and LiteLLM (incl. Bedrock/Router)
# providers. Each provider merges them in its own native parameter space, so use that provider's field names (e.g.
# `max_tokens` for OpenAI/Anthropic vs `max_output_tokens` for Gemini). The native Ollama structured-output path is a
# special case — see the note below. Also useful for custom model servers (e.g. vLLM `chat_template_kwargs`). On
# Anthropic, OpenAI Responses and Codex, an object adds to the one Hindsight sends instead of replacing it, so
# `{"output_config": {"effort": "low"}}` (Claude) or `{"text": {"verbosity": "low"}}` (OpenAI) keeps the response
# schema Hindsight puts in that same object.
# 默认（官方文档）：`null`
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_LLM_EXTRA_BODY=
# JSON dict passed as `default_headers` to provider SDK clients. Used by operators routing through proxies /
# request-tracing middleware (e.g. Cloudflare AI Gateway, Helicone, corporate proxies). Wired into the Anthropic
# provider, the OpenAI-compatible providers, Fireworks, Nous, the OpenAI Responses API, and the LiteLLM-backed
# providers (`litellm`, `litellmrouter`, `bedrock`); other providers can opt in.
# 默认（官方文档）：`null`
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_LLM_DEFAULT_HEADERS=
# JSON-encoded list of `{category, threshold}` dicts for Gemini/VertexAI content safety filtering
# 默认（官方文档）：`null`
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_LLM_GEMINI_SAFETY_SETTINGS=
# Reuse the fixed system prefix via the provider's explicit prompt cache, billed at the cached-input rate
# (Gemini/Vertex `CachedContent`). The cached prefix is shared across all banks and soft-fails to an uncached call.
# Set to `false` to disable. See [Models](./models#provider-capabilities).
# 默认（官方文档）：`true`
# HINDSIGHT_API_LLM_PROMPT_CACHE_ENABLED=true

# =============================================================================
# 官方文档补充 / LLM Router (LiteLLM Router)
# =============================================================================
# JSON object passed to `litellm.Router(**config)`. Required when provider is `litellmrouter`.
# 默认（官方文档）：Not specified in this table
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_LLM_LITELLMROUTER_CONFIG=

# =============================================================================
# 官方文档补充 / Built-in llama.cpp
# =============================================================================
# Path to a GGUF model file. If not set, auto-downloads `gemma-4-E2B-it-Q4_K_M` from HuggingFace.
# 默认（官方文档）：Auto-download
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_LLAMACPP_MODEL_PATH=
# Number of layers to offload to GPU. `-1` = all layers (recommended). `0` = CPU only.
# 默认（官方文档）：`-1`
# HINDSIGHT_API_LLAMACPP_GPU_LAYERS=-1
# Context window size in tokens.
# 默认（官方文档）：`8192`
# HINDSIGHT_API_LLAMACPP_CONTEXT_SIZE=8192
# Chat template format. `null` = auto-detect from GGUF metadata (recommended).
# 默认（官方文档）：Auto-detect
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_LLAMACPP_CHAT_FORMAT=
# Disable JSON grammar enforcement. Faster inference but less reliable JSON output.
# 默认（官方文档）：`false`
# HINDSIGHT_API_LLAMACPP_NO_GRAMMAR=false
# Space-separated extra CLI args passed to the llama.cpp server (e.g. `--n_threads 8 --type_k 1`).
# 默认（官方文档）：-
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_LLAMACPP_EXTRA_ARGS=

