# 默认（官方文档）：-；下一行为上游示例值。
# HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=https://api.openai.com/v1
# JSON dict of extra request-body params sent on every embeddings call for the `openai`, `openrouter` and `requesty`
