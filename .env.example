# HINDSIGHT_API_FILE_STORAGE_AZURE_ACCOUNT_KEY=

# =============================================================================
# 官方文档补充 / Observations (Experimental) {#observations}
# =============================================================================
# Enable observation consolidation
# 默认（官方文档）：`true`
# HINDSIGHT_API_ENABLE_OBSERVATIONS=true
# Automatically trigger consolidation after retain, delete, and update operations. When `false`, consolidation only
# runs when explicitly triggered via the [consolidate endpoint](/developer/api/operations#consolidation).
# Configurable per bank.
# 默认（官方文档）：`true`
# HINDSIGHT_API_ENABLE_AUTO_CONSOLIDATION=true
# Interval for the background sweep that re-schedules consolidation for banks with unconsolidated facts but no
# consolidation in progress — recovering facts left unscheduled when a consolidation operation failed terminally
# (e.g. the LLM provider was unavailable). Only applies to banks with auto-consolidation enabled. `0` disables the
# sweep — but see the note below: that stops work being *scheduled*, not work already queued from *running*.
# 默认（官方文档）：`300`
# HINDSIGHT_API_CONSOLIDATION_RECONCILE_INTERVAL_SECONDS=300
# How often the background loop checks for cron-scheduled mental models that are due for a refresh. This is only the
# *check* cadence; the actual schedule is the per-model `trigger.refresh_cron` expression set on the mental model. A
# due model is refreshed only when it is stale (new memories in its scope since the last refresh). It also sets a
# **floor on cron granularity** — at the default, a `* * * * *` schedule fires every 5 minutes, not every minute;
# lower it if you need finer schedules, at the cost of a more frequent cross-tenant scan (see [Background
# Maintenance](#background-maintenance)). `0` disables the sweep — but see the note below: that stops work being
# *scheduled*, not work already queued from *running*.
# 默认（官方文档）：`300`
# HINDSIGHT_API_MENTAL_MODEL_REFRESH_TICK_SECONDS=300
# Track history of changes to each observation (previous text/tags/dates + timestamp), stored one row per change in
# the `observation_history` table. Set to `false` to disable entirely — no history rows are written. **This is how
# you turn the feature off** (not a zero cap).
# 默认（官方文档）：`true`
# HINDSIGHT_API_ENABLE_OBSERVATION_HISTORY=true
# Max history rows kept per observation. On each update the previous version is inserted into the
# `observation_history` table and the oldest rows beyond this cap are deleted, so an often-reinforced observation's
# history can't grow without bound. `0` or a negative value **removes the cap** (unbounded); to turn history off
# entirely set `HINDSIGHT_API_ENABLE_OBSERVATION_HISTORY=false` instead.
# 默认（官方文档）：`50`
# HINDSIGHT_API_OBSERVATION_HISTORY_MAX_ENTRIES=50
# Outer retry attempts for the consolidation LLM batch call, used only for connection and rate-limit style failures
# (with backoff between attempts). Malformed or schema-invalid output is not re-sent — the batch fails immediately
# and is split into smaller batches instead. A provider quota exhaustion is not retried here at all: the whole job is
# rescheduled for when quota reopens. Each retried attempt uses the inner retry budget
# (`HINDSIGHT_API_CONSOLIDATION_LLM_MAX_RETRIES`), so worst-case API calls per batch = `MAX_ATTEMPTS ×
# (LLM_MAX_RETRIES + 1)`.
# 默认（官方文档）：`3`
# HINDSIGHT_API_CONSOLIDATION_MAX_ATTEMPTS=3
# Memories to load per batch (internal optimization)
# 默认（官方文档）：`50`
# HINDSIGHT_API_CONSOLIDATION_BATCH_SIZE=50
# Maximum memories processed per consolidation round. When the limit is reached, the job yields its worker slot and
# re-queues itself so other banks get fair scheduling. Mental model refreshes only run on the final round. `0` =
# unlimited. Configurable per bank.
# 默认（官方文档）：`100`
# HINDSIGHT_API_CONSOLIDATION_MAX_MEMORIES_PER_ROUND=100
# Max tokens for recall when finding related observations during consolidation
# 默认（官方文档）：`1024`
# HINDSIGHT_API_CONSOLIDATION_MAX_TOKENS=1024
# Max completion tokens requested for each consolidation LLM batch call. Unset by default, so each provider keeps its
# implicit output budget. Set this when a provider applies a low hidden cap (e.g. Bedrock imported models) that
# truncates consolidation output.
# 默认（官方文档）：`unset`
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_CONSOLIDATION_MAX_COMPLETION_TOKENS=
# Number of facts sent to the LLM in a single consolidation call. Higher values reduce LLM calls and improve
# throughput at the cost of larger prompts. Set to `1` to disable batching. Configurable per bank.
# 默认（官方文档）：`8`
# HINDSIGHT_API_CONSOLIDATION_LLM_BATCH_SIZE=8
# Maximum number of tag groups consolidated concurrently within one consolidation op. Each group acquires per-scope
# locks before processing, so groups whose write scopes overlap (e.g. under `per_tag` / `all_combinations` /
# explicit-list `observation_scopes`) automatically serialise on the overlapping scopes — actual concurrency may be
# lower than this cap when scopes contend. Set to `1` for fully sequential behaviour. Higher values raise peak LLM
# QPS and connection-pool usage during consolidation proportionally — tune down if your LLM provider rate-limits
# tightly or your DB pool is small. Configurable per bank.
# 默认（官方文档）：`4`
# HINDSIGHT_API_CONSOLIDATION_LLM_PARALLELISM=4
# Budget level for the recall pass inside consolidation (`low`, `mid`, `high`). Lower budgets fetch fewer candidate
# rows, reducing peak memory usage on large banks.
# 默认（官方文档）：`low`
# HINDSIGHT_API_CONSOLIDATION_RECALL_BUDGET=low
# Total token budget for source facts included with observations in the consolidation prompt. `-1` = unlimited.
# Configurable per bank.
# 默认（官方文档）：`4096`
# HINDSIGHT_API_CONSOLIDATION_SOURCE_FACTS_MAX_TOKENS=4096
# Per-observation token cap for source facts in the consolidation prompt. Each observation independently gets at most
# this many tokens of source facts. `-1` = unlimited. Configurable per bank.
# 默认（官方文档）：`256`
# HINDSIGHT_API_CONSOLIDATION_SOURCE_FACTS_MAX_TOKENS_PER_OBSERVATION=256
# What this bank should synthesise into durable observations. Replaces the built-in consolidation rules — leave unset
# to use the server default.
# 默认（官方文档）：-
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_OBSERVATIONS_MISSION=
# Maximum number of observations allowed per tag scope. When the limit is reached, consolidation will only update or
# delete existing observations — no new ones are created. Applies per tag scope (e.g., per-tag when using `per_tag`
# observation scopes). Observations with no tags are not subject to this limit. `-1` = unlimited. Configurable per
# bank.
# 默认（官方文档）：`-1`
# HINDSIGHT_API_MAX_OBSERVATIONS_PER_SCOPE=-1
# **Deprecated** — use `CONSOLIDATION_STRATEGIES`, which carries the mission too; this is still honoured, but
# consulted only afterwards. Per-scope overrides of `MAX_OBSERVATIONS_PER_SCOPE`, as a JSON array of `{"scope":
# [tag-globs], "limit": int}` rules. Each `scope` is a list of
# [fnmatch](https://docs.python.org/3/library/fnmatch.html) globs; a consolidation scope matches under *exact cover*
# — every tag must be matched by a glob and every glob must match a tag, so `["shared"]` matches the scope `{shared}`
# but not `{run_1, shared}`. The first matching rule wins; scopes that match no rule fall back to
# `MAX_OBSERVATIONS_PER_SCOPE`. Example: `[{"scope": ["shared"], "limit": -1}, {"scope": ["run_*", "shared"],
# "limit": 50}]` keeps the `{shared}` scope unlimited while capping each `{run_*, shared}` scope at 50. Configurable
# per bank.
# 默认（官方文档）：-
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_OBSERVATION_SCOPE_LIMITS=

# =============================================================================
# 官方文档补充 / Reflect
# =============================================================================
# Max tool call iterations before forcing a response
# 默认（官方文档）：`10`
# HINDSIGHT_API_REFLECT_MAX_ITERATIONS=10
# Max accumulated context tokens in the reflect loop before forcing final synthesis. Prevents
# `context_length_exceeded` errors on large banks. Lower this if your LLM has a context window smaller than 128K.
# 默认（官方文档）：`100000`
# HINDSIGHT_API_REFLECT_MAX_CONTEXT_TOKENS=100000
# Wall-clock timeout in seconds for the entire reflect operation. If exceeded, the request returns HTTP 504. Also
# bounds a whole mental-model refresh in the worker: one that runs past it is cancelled and marked failed instead of
# holding its worker slot.
# 默认（官方文档）：`300`
# HINDSIGHT_API_REFLECT_WALL_TIMEOUT=300
# Global reflect mission (identity and reasoning framing). Overridden per bank via config API.
# 默认（官方文档）：-
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_REFLECT_MISSION=
# Token budget for source facts in `search_observations` during reflect. `-1` disables source facts (default), `0`
# enables with no limit, `>0` enables with a token budget. Hierarchical — can be overridden per bank via config API.
# 默认（官方文档）：`-1`
# HINDSIGHT_API_REFLECT_SOURCE_FACTS_MAX_TOKENS=-1

# =============================================================================
# 官方文档补充 / Internal recall (used by reflect and mental model refresh)
# =============================================================================
# Whether the internal recall returns raw chunk text alongside facts. Set `false` to skip chunks and save prompt
# budget.
# 默认（官方文档）：`true`
# HINDSIGHT_API_RECALL_INCLUDE_CHUNKS=true
# Token budget for facts returned by the internal recall.
# 默认（官方文档）：`2048`
# HINDSIGHT_API_RECALL_MAX_TOKENS=2048
# Token budget for raw chunks returned by the internal recall.
# 默认（官方文档）：`1000`
# HINDSIGHT_API_RECALL_CHUNKS_MAX_TOKENS=1000

# =============================================================================
# 官方文档补充 / Disposition
# =============================================================================
# How skeptical vs trusting (1=trusting, 5=skeptical)
# 默认（官方文档）：`3`
# HINDSIGHT_API_DISPOSITION_SKEPTICISM=3
# How literally to interpret information (1=flexible, 5=literal)
# 默认（官方文档）：`3`
# HINDSIGHT_API_DISPOSITION_LITERALISM=3
# How much to consider emotional context (1=detached, 5=empathetic)
# 默认（官方文档）：`3`
# HINDSIGHT_API_DISPOSITION_EMPATHY=3

# =============================================================================
# 官方文档补充 / MCP Server
# =============================================================================
# Comma-separated allowlist of MCP tools to expose globally (empty = all tools)
# 默认（官方文档）：-
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_MCP_ENABLED_TOOLS=
# Use stateless HTTP transport (POST-only). When `false`, enables stateful mode with GET/SSE support for
# server-initiated messages
# 默认（官方文档）：`false`
# HINDSIGHT_API_MCP_STATELESS=false
# Memory bank ID for local MCP
# 默认（官方文档）：`mcp`
# HINDSIGHT_API_MCP_LOCAL_BANK_ID=mcp
# Additional instructions appended to retain/recall tool descriptions
# 默认（官方文档）：-
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_MCP_INSTRUCTIONS=

# =============================================================================
# 官方文档补充 / Distributed Workers
# =============================================================================
# Enable the internal worker in the API process. Set to `false` to stop this process claiming and running queued
# background operations (consolidation, retain, mental model refresh) — this, not the maintenance interval knobs, is
# what quiesces execution.
# 默认（官方文档）：`true`
# HINDSIGHT_API_WORKER_ENABLED=true
# Unique worker identifier
# 默认（官方文档）：hostname
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_WORKER_ID=
# Database polling interval in milliseconds
# 默认（官方文档）：`500`
# HINDSIGHT_API_WORKER_POLL_INTERVAL_MS=500
# Max retries before marking task failed
# 默认（官方文档）：`3`
# HINDSIGHT_API_WORKER_MAX_RETRIES=3
# Seconds between retries on transient task failure
# 默认（官方文档）：`60`
# HINDSIGHT_API_WORKER_TASK_RETRY_BACKOFF_SECONDS=60
# HTTP port for worker metrics/health (worker CLI only)
# 默认（官方文档）：`8889`
# HINDSIGHT_API_WORKER_HTTP_PORT=8889
# Maximum concurrent tasks per worker (total across all operation types)
# 默认（官方文档）：`10`
# HINDSIGHT_API_WORKER_MAX_SLOTS=10
# Reserved (minimum) slots for consolidation within `WORKER_MAX_SLOTS` — a floor that guarantees capacity, **not** a
# per-type cap (bank-serialization preserved). See the note below.
# 默认（官方文档）：`2`
# HINDSIGHT_API_WORKER_CONSOLIDATION_RESERVED_SLOTS=2
# Per-bank priority for consolidation scheduling (see note below)
# 默认（官方文档）：_(unset)_
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_WORKER_CONSOLIDATION_BANK_PRIORITY=
# Reserved (minimum) slots for retain within `WORKER_MAX_SLOTS`.
# 默认（官方文档）：`0`
# HINDSIGHT_API_WORKER_RETAIN_RESERVED_SLOTS=0
# Reserved (minimum) slots for file_convert_retain within `WORKER_MAX_SLOTS`.
# 默认（官方文档）：`0`
# HINDSIGHT_API_WORKER_FILE_CONVERT_RETAIN_RESERVED_SLOTS=0
# Reserved (minimum) slots for refresh_mental_model within `WORKER_MAX_SLOTS`.
# 默认（官方文档）：`0`
# HINDSIGHT_API_WORKER_REFRESH_MENTAL_MODEL_RESERVED_SLOTS=0
# Reserved (minimum) slots for graph_maintenance within `WORKER_MAX_SLOTS`.
# 默认（官方文档）：`0`
# HINDSIGHT_API_WORKER_GRAPH_MAINTENANCE_RESERVED_SLOTS=0
# Reserved (minimum) slots for import_documents within `WORKER_MAX_SLOTS`.
# 默认（官方文档）：`0`
# HINDSIGHT_API_WORKER_IMPORT_DOCUMENTS_RESERVED_SLOTS=0
# Reserved (minimum) slots for export_bank within `WORKER_MAX_SLOTS`.
# 默认（官方文档）：`0`
# HINDSIGHT_API_WORKER_EXPORT_BANK_RESERVED_SLOTS=0
# Reserved (minimum) slots for import_bank within `WORKER_MAX_SLOTS`.
# 默认（官方文档）：`0`
# HINDSIGHT_API_WORKER_IMPORT_BANK_RESERVED_SLOTS=0
# Reserved (minimum) slots for knowledge bank ingests (knowledge_ingest) within `WORKER_MAX_SLOTS`.
# 默认（官方文档）：`0`
# HINDSIGHT_API_WORKER_KNOWLEDGE_INGEST_RESERVED_SLOTS=0

# =============================================================================
# 官方文档补充 / Performance Optimization
# =============================================================================
# Skip LLM connection check on startup. The check sends one test call per configured LLM (each failover member
# separately), waits at most 10s for each, and only logs a warning on failure or timeout, so a slow or busy LLM
# backend never blocks startup.
# 默认（官方文档）：`false`
# HINDSIGHT_API_SKIP_LLM_VERIFICATION=false

# =============================================================================
# 官方文档补充 / Bank stats cache
# =============================================================================
# Time-to-live (seconds) for the `get_bank_stats` result cache. `0` disables caching, so every call runs the query.
# 默认（官方文档）：`60`
# HINDSIGHT_API_BANK_STATS_CACHE_TTL_SECONDS=60
# Maximum number of cached `(schema, bank)` entries before LRU eviction. Bounds memory in deployments with many
# banks.
# 默认（官方文档）：`1024`
# HINDSIGHT_API_BANK_STATS_CACHE_MAX_ENTRIES=1024

# =============================================================================
# 官方文档补充 / Webhooks
# =============================================================================
# Global webhook URL for event delivery
# 默认（官方文档）：- (disabled)
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_WEBHOOK_URL=
# HMAC signing secret for webhook payloads
# 默认（官方文档）：- (unsigned)
# 安全：敏感项示例占位符，必须替换；不设置时保持注释以保留继承/环境认证行为。
# HINDSIGHT_API_WEBHOOK_SECRET=replace-with-your-secret
# Comma-separated list of event types to deliver via webhook
# 默认（官方文档）：`consolidation.completed`
# HINDSIGHT_API_WEBHOOK_EVENT_TYPES=consolidation.completed

# =============================================================================
# 官方文档补充 / Audit Logging
# =============================================================================
# Whether audit events are written. Hierarchical — can be overridden per bank via the config API.
# 默认（官方文档）：`false`
# HINDSIGHT_API_AUDIT_LOG_ENABLED=false
# Comma-separated allowlist of action types to audit (empty = all eligible actions)
# 默认（官方文档）：`""`
# HINDSIGHT_API_AUDIT_LOG_ACTIONS=""
# Number of days to retain audit log entries. `-1` = keep forever.
# 默认（官方文档）：`-1`
# HINDSIGHT_API_AUDIT_LOG_RETENTION_DAYS=-1

# =============================================================================
# 官方文档补充 / OpenTelemetry Tracing
# =============================================================================
# Include `bank_id` in OTel metric attributes. Enable only for deployments with few banks — high cardinality causes
# unbounded memory growth.
# 默认（官方文档）：`false`
# HINDSIGHT_API_METRICS_INCLUDE_BANK_ID=false

# =============================================================================
# 官方文档补充 / Control Plane
# =============================================================================
# Maximum size of a single file-upload request the Control Plane accepts before truncating it. Accepts a size string
# (`100mb`, `1gb`) or a number of bytes. Raise this to upload files larger than the default, and keep it in line with
# the API's `HINDSIGHT_API_FILE_CONVERSION_MAX_BATCH_SIZE_MB`.
# 默认（官方文档）：`100mb`
# HINDSIGHT_CP_MAX_UPLOAD_SIZE=100mb

# =============================================================================
# 官方文档补充 / Enabling the API
# =============================================================================
# Allow clients to change per-bank configuration (`PATCH`/`DELETE .../config`). Reading a bank's config is always
# allowed.
# 默认（官方文档）：`true`
# HINDSIGHT_API_ENABLE_BANK_CONFIG_API=true
# Enable the per-bank LLM connectivity probe (`POST /v1/default/banks/{bank_id}/health/llm`). It makes a real
# provider call, so it is **off by default** — enable it to expose the endpoint. Returns status only — never the
# provider/model/endpoint.
# 默认（官方文档）：`false`
# HINDSIGHT_API_ENABLE_BANK_LLM_HEALTH=false
# Bank template manifest (JSON) applied automatically to every newly-created bank. See below.
# 默认（官方文档）：_(unset)_
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_DEFAULT_BANK_TEMPLATE=

# =============================================================================
# config.py 补充：源代码支持但上游模板未完整列出的静态配置
# =============================================================================
# Store-owned retain：最后一次性写文档正文；默认 false。开启会削弱增量落盘保证，中断可能留下已提交记忆但缺失正文。
# HINDSIGHT_API_RETAIN_BATCH_DOCUMENT_WRITES=false
# 进程内银行信息/配置缓存秒数，默认 30.0；0 禁用。提高会增加配置陈旧窗口。
# HINDSIGHT_API_BANK_INFO_CACHE_TTL_SECONDS=30.0
# 银行信息缓存 LRU 最大条目数，默认 2048。
# HINDSIGHT_API_BANK_INFO_CACHE_MAX_ENTRIES=2048
# 自有索引 store 的 retain 写阶段并发上限，默认 16；与 SQL retain 并发上限不同，增大会增加内存。
# HINDSIGHT_API_RETAIN_STORE_MAX_CONCURRENT=16
# OpenRouter embeddings/reranker 共用回退密钥；默认未设置。
# 安全：仅凭证占位符，不包含本机密钥。
# HINDSIGHT_API_OPENROUTER_API_KEY=replace-with-your-secret
# Requesty embeddings 共用回退密钥；默认未设置。
# 安全：仅凭证占位符，不包含本机密钥。
# HINDSIGHT_API_REQUESTY_API_KEY=replace-with-your-secret
# Cohere embeddings/reranker 共用回退密钥；默认未设置。
# 安全：仅凭证占位符，不包含本机密钥。
# HINDSIGHT_API_COHERE_API_KEY=replace-with-your-secret
# 旧的共用 LiteLLM proxy 地址；reranker 专用地址优先，默认 http://localhost:4000。
# HINDSIGHT_API_LITELLM_API_BASE=http://localhost:4000
# 旧的共用 LiteLLM proxy 密钥；reranker 专用密钥优先，默认未设置。
# 安全：仅凭证占位符，不包含本机密钥。
# HINDSIGHT_API_LITELLM_API_KEY=replace-with-your-secret
# 该操作的多模型路由策略，未设置时继承全局；示例 failover；metadata 模式只支持 retain。
# HINDSIGHT_API_RETAIN_LLM_STRATEGY='{"mode":"failover"}'
# 该操作 LiteLLM Router 配置，未设置时继承全局；须填有效 Router JSON，不能只取消注释为空。
# HINDSIGHT_API_RETAIN_LLM_LITELLMROUTER_CONFIG=
# 该操作的多模型路由策略，未设置时继承全局；示例 failover；metadata 模式只支持 retain。
# HINDSIGHT_API_REFLECT_LLM_STRATEGY='{"mode":"failover"}'
# 该操作 LiteLLM Router 配置，未设置时继承全局；须填有效 Router JSON，不能只取消注释为空。
# HINDSIGHT_API_REFLECT_LLM_LITELLMROUTER_CONFIG=
# 该操作的多模型路由策略，未设置时继承全局；示例 failover；metadata 模式只支持 retain。
# HINDSIGHT_API_CONSOLIDATION_LLM_STRATEGY='{"mode":"failover"}'
# 该操作 LiteLLM Router 配置，未设置时继承全局；须填有效 Router JSON，不能只取消注释为空。
# HINDSIGHT_API_CONSOLIDATION_LLM_LITELLMROUTER_CONFIG=
# 该操作的多模型路由策略，未设置时继承全局；示例 failover；metadata 模式只支持 retain。
# HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_STRATEGY='{"mode":"failover"}'
# 该操作 LiteLLM Router 配置，未设置时继承全局；须填有效 Router JSON，不能只取消注释为空。
# HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_LITELLMROUTER_CONFIG=

# =============================================================================
# 动态前缀配置：以下均为真实可用的具体变量名，不写通配符伪变量
# =============================================================================
# 多 LLM：数字 1 表示第一个额外成员；必须从 1 连续编号，遇到缺失 PROVIDER 就停止。
# 可在 LLM 前加 RETAIN_、REFLECT_、CONSOLIDATION_、MENTAL_MODEL_REFRESH_，配置该操作自己的成员。
# 示例可把 HINDSIGHT_API_LLM_1_TIMEOUT 改为 HINDSIGHT_API_RETAIN_LLM_1_TIMEOUT。
# 成员设置按 provider 生效；以下相互独立示例不要全部启用。
# 额外成员 1 API 地址，默认 provider 地址；此处示例。
# HINDSIGHT_API_LLM_1_BASE_URL=https://api.openai.com/v1
# 额外成员 1 推理强度，值须被模型支持；未设置按继承规则处理。
# HINDSIGHT_API_LLM_1_REASONING_EFFORT=low
# 额外成员 1 请求体 JSON；默认无成员专属覆盖。
# HINDSIGHT_API_LLM_1_EXTRA_BODY='{"top_p":0.9}'
# 额外成员 1 请求头 JSON；敏感头应保护；默认无成员专属覆盖。
# HINDSIGHT_API_LLM_1_DEFAULT_HEADERS='{"X-Example-Trace":"hindsight"}'
# 额外成员 1 缓存亲和性；示例 none，不声明默认。
# HINDSIGHT_API_LLM_1_CACHE_AFFINITY=none
# 额外 Bedrock 成员服务层级示例；flex/priority/reserved，默认无成员覆盖。
# HINDSIGHT_API_LLM_1_BEDROCK_SERVICE_TIER=flex
# 额外 Gemini 成员服务层级示例 flex，默认无成员覆盖。
# HINDSIGHT_API_LLM_1_GEMINI_SERVICE_TIER=flex
# 额外 Vertex 成员项目示例；未设置回退全局项目。
# HINDSIGHT_API_LLM_1_VERTEXAI_PROJECT_ID=your-gcp-project
# 额外 Vertex 成员区域示例；未设置回退全局区域/us-central1。
# HINDSIGHT_API_LLM_1_VERTEXAI_REGION=us-central1
# 额外 Vertex 成员凭证文件路径示例；未设置回退全局/ADC；需挂载文件，不要写私钥正文。
# HINDSIGHT_API_LLM_1_VERTEXAI_SERVICE_ACCOUNT_KEY=/run/secrets/google-service-account.json
# 额外 Router 成员配置，默认回退全局；须先填写有效 JSON。
# HINDSIGHT_API_LLM_1_LITELLMROUTER_CONFIG=
# 额外成员 1 请求超时秒数；默认继承该操作；示例 120。
# HINDSIGHT_API_LLM_1_TIMEOUT=120
# 额外成员 1 重试次数；默认继承该操作；0 表示不重试立即 failover。
# HINDSIGHT_API_LLM_1_MAX_RETRIES=0
# PASSAGE_EMBEDDINGS_ 仅用于存储文本；默认回退全局，示例 openai；切换向量空间需迁移数据。
# HINDSIGHT_API_PASSAGE_EMBEDDINGS_PROVIDER=openai
# 存储侧 embedding endpoint 示例；仅吞吐或量化实现可以不同，语义向量空间必须匹配。
# HINDSIGHT_API_PASSAGE_EMBEDDINGS_OPENAI_BASE_URL=http://passage-embedder:8080/v1
# reranker 成员专属设置：在 RERANKER_ 后插入数字；同名设置的内置默认为 60 秒。
# HINDSIGHT_API_RERANKER_1_COHERE_TIMEOUT=60
# reranker 成员专属 TEI 服务地址示例；成员编号从 1 开始。
# HINDSIGHT_API_RERANKER_1_TEI_URL=http://localhost:8080
# reranker 成员专属 TEI HTTP 超时秒数；未设置时使用该设置的内置默认值。
# HINDSIGHT_API_RERANKER_1_TEI_HTTP_TIMEOUT=60
# KB_TEXT_EMBEDDINGS_ 可采用 EMBEDDINGS_ 设置的后缀；text provider 的 OpenAI endpoint 示例。
# HINDSIGHT_API_KB_TEXT_EMBEDDINGS_OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
# 官方 standalone 镜像启动器及 Dockerfile 公开运行环境
# =============================================================================
# 官方 all-in-one 镜像是否启动 API；默认 true；只识别字符串 true。
# HINDSIGHT_ENABLE_API=true
# 官方 all-in-one 镜像是否启动控制台；默认 true；只识别字符串 true。
# HINDSIGHT_ENABLE_CP=true
# 镜像控制台监听地址，默认 0.0.0.0；不要用 HOSTNAME 代替此变量。
# HINDSIGHT_CP_HOSTNAME=0.0.0.0
# 镜像控制台容器内端口，默认 9999；修改不会同步修改 compose 端口映射。
# HINDSIGHT_CP_PORT=9999
# 镜像 API 就绪探测 URL；默认 http://localhost:${HINDSIGHT_API_PORT:-8888}/health；示例为默认端口。
# HINDSIGHT_API_HEALTH_URL=http://localhost:8888/health
# 镜像启动前轮询数据库及 LLM /models；默认 false。无 /models 接口的 provider 不宜开启。
# HINDSIGHT_WAIT_FOR_DEPS=false
# WAIT_FOR_DEPS 依赖探测次数上限，默认 0 表示无限重试，可能永久等待。
# HINDSIGHT_RETRY_MAX=0
# WAIT_FOR_DEPS 依赖探测间隔秒数，默认 10。
# HINDSIGHT_RETRY_INTERVAL=10
# 官方镜像 Node 运行环境默认 production；不要在生产环境改为 development。
# NODE_ENV=production
# 官方镜像 Python 日志无缓冲，默认 1。
# PYTHONUNBUFFERED=1
# 官方镜像 Transformers 日志级别默认 error；调试日志可能暴露环境或内容。
# TRANSFORMERS_VERBOSITY=error
# 官方镜像 Hugging Face Hub 日志级别默认 error。
# HF_HUB_VERBOSITY=error
# 官方镜像 tokenizer 并行开关默认 false。
# TOKENIZERS_PARALLELISM=false

# 范围限制：不列出 HINDSIGHT_START_ALL_SOURCE_ONLY（测试/脚本导入开关），也不列 Docker ARG 为运行时变量。
# 自定义扩展可消费任意后缀，无法穷举；FILE_STORAGE_/TENANT_/OPERATION_VALIDATOR_ 配置须按扩展实现。
# 兼容性：旧版 KNOWLEDGE_PAGE_DEFAULT_TRIGGER 已废弃；旧 token-limit alias 优先使用文档中的新变量。
# 非 Hindsight 前缀的第三方 SDK 环境变量未穷举，例如云厂商环境认证及代理/CA/Hugging Face 缓存设置。
# 来源覆盖不等于已执行验证；未启动镜像、未测试 provider、未读取本机 .env 或密钥。
