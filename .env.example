# =============================================================================
# 官方文档补充 / Reranker
# =============================================================================
# Max concurrent local reranking (prevents CPU thrashing under load)
# 默认（官方文档）：`4`
# HINDSIGHT_API_RERANKER_LOCAL_MAX_CONCURRENT=4
# Allow loading models with custom code (security risk, disabled by default)
# 默认（官方文档）：`false`
# HINDSIGHT_API_RERANKER_LOCAL_TRUST_REMOTE_CODE=false
# Half-precision (FP16) inference for the local reranker. Faster on CUDA; on CPU it halves the model's memory but may
# not be faster. Rankings barely change (identical top-10 for `BAAI/bge-reranker-v2-m3` in testing). Disabled by
# default because some CPUs lack native FP16 support.
# 默认（官方文档）：`false`
# HINDSIGHT_API_RERANKER_LOCAL_FP16=false
# Sort pairs by token length before batching to reduce padding waste. 36–54% faster across models; quality-identical
# by construction.
# 默认（官方文档）：`false`
# HINDSIGHT_API_RERANKER_LOCAL_BUCKET_BATCHING=false
# Batch size for local reranker `predict()`. Optimal value varies by hardware and model (smaller batches can
# outperform larger ones).
# 默认（官方文档）：`32`
# HINDSIGHT_API_RERANKER_LOCAL_BATCH_SIZE=32
# Batch size for TEI reranking
# 默认（官方文档）：`128`
# HINDSIGHT_API_RERANKER_TEI_BATCH_SIZE=128
# Max concurrent TEI reranking requests
# 默认（官方文档）：`8`
# HINDSIGHT_API_RERANKER_TEI_MAX_CONCURRENT=8
# HTTP request timeout for TEI reranker (seconds). Increase when using a slower CPU-based reranker under load.
# 默认（官方文档）：`30.0`
# HINDSIGHT_API_RERANKER_TEI_HTTP_TIMEOUT=30.0
# OpenRouter API key for reranking (falls back to `HINDSIGHT_API_OPENROUTER_API_KEY`, then
# `HINDSIGHT_API_LLM_API_KEY`)
# 默认（官方文档）：-
# 安全：敏感项示例占位符，必须替换；不设置时保持注释以保留继承/环境认证行为。
# HINDSIGHT_API_RERANKER_OPENROUTER_API_KEY=replace-with-your-secret
# OpenRouter rerank model
# 默认（官方文档）：`cohere/rerank-v3.5`
# HINDSIGHT_API_RERANKER_OPENROUTER_MODEL=cohere/rerank-v3.5
# HTTP request timeout for OpenRouter reranker (seconds).
# 默认（官方文档）：`60.0`
# HINDSIGHT_API_RERANKER_OPENROUTER_TIMEOUT=60.0
# Rerank endpoint URL (point at a Cohere-compatible gateway/proxy for metering)
# 默认（官方文档）：`https://openrouter.ai/api/v1/rerank`
# HINDSIGHT_API_RERANKER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/rerank
# Hindsight Inference key for reranking (`hs-rerank-1`). Without it, the key `hindsight-admin cloud login` saved
# 默认（官方文档）：-
# 安全：敏感项示例占位符，必须替换；不设置时保持注释以保留继承/环境认证行为。
# HINDSIGHT_API_RERANKER_HINDSIGHT_API_KEY=replace-with-your-secret
# Cohere API key for reranking (falls back to `HINDSIGHT_API_COHERE_API_KEY`)
# 默认（官方文档）：-
# 安全：敏感项示例占位符，必须替换；不设置时保持注释以保留继承/环境认证行为。
# HINDSIGHT_API_RERANKER_COHERE_API_KEY=replace-with-your-secret
# Cohere rerank model
# 默认（官方文档）：`rerank-english-v3.0`
# HINDSIGHT_API_RERANKER_COHERE_MODEL=rerank-english-v3.0
# Custom base URL for any Cohere-compatible `/rerank` endpoint (Azure AI Foundry, Jina, Voyage, self-hosted BGE,
# etc.). When set, the `cohere` provider bypasses the Cohere SDK and calls the endpoint directly via HTTP.
# 默认（官方文档）：-
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_RERANKER_COHERE_BASE_URL=
# Request timeout for the Cohere reranker (seconds). Applies to both the native Cohere SDK and the Cohere-compatible
# HTTP path enabled by `HINDSIGHT_API_RERANKER_COHERE_BASE_URL`.
# 默认（官方文档）：`60.0`
# HINDSIGHT_API_RERANKER_COHERE_TIMEOUT=60.0
# LiteLLM proxy base URL for reranking (falls back to `HINDSIGHT_API_LITELLM_API_BASE`)
# 默认（官方文档）：`http://localhost:4000`
# HINDSIGHT_API_RERANKER_LITELLM_API_BASE=http://localhost:4000
# LiteLLM proxy API key for reranking (optional, depends on proxy config; falls back to
# `HINDSIGHT_API_LITELLM_API_KEY`)
# 默认（官方文档）：-
# 安全：敏感项示例占位符，必须替换；不设置时保持注释以保留继承/环境认证行为。
# HINDSIGHT_API_RERANKER_LITELLM_API_KEY=replace-with-your-secret
# LiteLLM **proxy** rerank model (use provider prefix, e.g., `cohere/rerank-english-v3.0`)
# 默认（官方文档）：`cohere/rerank-english-v3.0`
# HINDSIGHT_API_RERANKER_LITELLM_MODEL=cohere/rerank-english-v3.0
# HTTP request timeout for the LiteLLM proxy reranker (seconds).
# 默认（官方文档）：`60.0`
# HINDSIGHT_API_RERANKER_LITELLM_TIMEOUT=60.0
# LiteLLM **SDK** API key for direct reranking (no proxy needed)
# 默认（官方文档）：-
# 安全：敏感项示例占位符，必须替换；不设置时保持注释以保留继承/环境认证行为。
# HINDSIGHT_API_RERANKER_LITELLM_SDK_API_KEY=replace-with-your-secret
# LiteLLM SDK rerank model (e.g., `deepinfra/Qwen3-reranker-8B`)
# 默认（官方文档）：`cohere/rerank-english-v3.0`
# HINDSIGHT_API_RERANKER_LITELLM_SDK_MODEL=cohere/rerank-english-v3.0
# Custom API base URL for LiteLLM SDK (optional)
# 默认（官方文档）：-
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_RERANKER_LITELLM_SDK_API_BASE=
# Request timeout for the LiteLLM SDK reranker (seconds).
# 默认（官方文档）：`60.0`
# HINDSIGHT_API_RERANKER_LITELLM_SDK_TIMEOUT=60.0
# ZeroEntropy API key for reranking
# 默认（官方文档）：-
# 安全：敏感项示例占位符，必须替换；不设置时保持注释以保留继承/环境认证行为。
# HINDSIGHT_API_RERANKER_ZEROENTROPY_API_KEY=replace-with-your-secret
# ZeroEntropy rerank model (`zerank-2`, `zerank-2-small`)
# 默认（官方文档）：`zerank-2`
# HINDSIGHT_API_RERANKER_ZEROENTROPY_MODEL=zerank-2
# Custom base URL for ZeroEntropy-compatible API (e.g., mock server, proxy, or self-hosted deployment)
# 默认（官方文档）：`https://api.zeroentropy.dev`
# HINDSIGHT_API_RERANKER_ZEROENTROPY_BASE_URL=https://api.zeroentropy.dev
# HTTP request timeout for ZeroEntropy reranker (seconds).
# 默认（官方文档）：`60.0`
# HINDSIGHT_API_RERANKER_ZEROENTROPY_TIMEOUT=60.0
# SiliconFlow API key for reranking
# 默认（官方文档）：-
# 安全：敏感项示例占位符，必须替换；不设置时保持注释以保留继承/环境认证行为。
# HINDSIGHT_API_RERANKER_SILICONFLOW_API_KEY=replace-with-your-secret
# SiliconFlow rerank model (e.g., `BAAI/bge-reranker-v2-m3`)
# 默认（官方文档）：`BAAI/bge-reranker-v2-m3`
# HINDSIGHT_API_RERANKER_SILICONFLOW_MODEL=BAAI/bge-reranker-v2-m3
# Base URL for the SiliconFlow `/rerank` endpoint
# 默认（官方文档）：`https://api.siliconflow.cn/v1`
# HINDSIGHT_API_RERANKER_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# HTTP request timeout for SiliconFlow reranker (seconds).
# 默认（官方文档）：`60.0`
# HINDSIGHT_API_RERANKER_SILICONFLOW_TIMEOUT=60.0
# **Deprecated.** HTTP request timeout for the TypeSafe reranker (seconds).
# 默认（官方文档）：`60.0`
# HINDSIGHT_API_RERANKER_TYPESAFE_TIMEOUT=60.0
# Alibaba Cloud DashScope API key for reranking
# 默认（官方文档）：-
# 安全：敏感项示例占位符，必须替换；不设置时保持注释以保留继承/环境认证行为。
# HINDSIGHT_API_RERANKER_ALIBABA_API_KEY=replace-with-your-secret
# DashScope rerank model
# 默认（官方文档）：`qwen3-rerank`
# HINDSIGHT_API_RERANKER_ALIBABA_MODEL=qwen3-rerank
# HTTP request timeout for the Alibaba Cloud DashScope reranker (seconds).
# 默认（官方文档）：`60.0`
# HINDSIGHT_API_RERANKER_ALIBABA_TIMEOUT=60.0
# Google Cloud project ID for Discovery Engine reranking (falls back to `HINDSIGHT_API_LLM_VERTEXAI_PROJECT_ID`)
# 默认（官方文档）：-
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_RERANKER_GOOGLE_PROJECT_ID=
# Google Discovery Engine ranking model
# 默认（官方文档）：`semantic-ranker-default-004`
# HINDSIGHT_API_RERANKER_GOOGLE_MODEL=semantic-ranker-default-004
# Path to service account JSON key (falls back to `HINDSIGHT_API_LLM_VERTEXAI_SERVICE_ACCOUNT_KEY`). If unset, uses
# ADC.
# 默认（官方文档）：-
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_RERANKER_GOOGLE_SERVICE_ACCOUNT_KEY=
# HTTP request timeout for Google Discovery Engine reranker (seconds).
# 默认（官方文档）：`60.0`
# HINDSIGHT_API_RERANKER_GOOGLE_TIMEOUT=60.0
# FlashRank model for fast CPU-based reranking
# 默认（官方文档）：`ms-marco-MiniLM-L-12-v2`
# HINDSIGHT_API_RERANKER_FLASHRANK_MODEL=ms-marco-MiniLM-L-12-v2
# Cache directory for FlashRank models
# 默认（官方文档）：System default
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_RERANKER_FLASHRANK_CACHE_DIR=
# Enable ONNX Runtime CPU memory arena for FlashRank. When `true`, ONNX pre-allocates a memory arena that never
# shrinks, causing RSS to grow monotonically. `false` trades slightly slower per-call allocation for bounded RSS.
# 默认（官方文档）：`false`
# HINDSIGHT_API_RERANKER_FLASHRANK_CPU_MEM_ARENA=false
# Local path to downloaded `jina-reranker-v3-mlx` model (auto-downloads from HuggingFace if unset)
# 默认（官方文档）：-
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_RERANKER_JINA_MLX_MODEL_PATH=

# =============================================================================
# 官方文档补充 / Authentication
# =============================================================================
# Dotted path to the loaded tenant extension. Set to `hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension`
# to require an API key on every request.
# 默认（官方文档）：*(none; auth disabled)*
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_TENANT_EXTENSION=
# Shared API key checked by the built-in API-key extension. Sent by clients as `Authorization: Bearer <key>`.
# 默认（官方文档）：*(none)*
# 安全：敏感项示例占位符，必须替换；不设置时保持注释以保留继承/环境认证行为。
# HINDSIGHT_API_TENANT_API_KEY=replace-with-your-secret

# =============================================================================
# 官方文档补充 / Server
# =============================================================================
# Number of uvicorn worker processes
# 默认（官方文档）：`1`
# HINDSIGHT_API_WORKERS=1
# Enable uvicorn access log (`true`, `1`, `yes`, `on` to enable)
# 默认（官方文档）：`false`
# HINDSIGHT_API_ACCESS_LOG=false
# What to do when running on a free-threaded (`python3.14t`) interpreter: `strict` refuses to start if the GIL is
# still enabled, `warn` logs and continues, `off` disables the check. Unset lets the interpreter decide — `strict` on
# a free-threaded build, `off` on a normal one.
# 默认（官方文档）：interpreter-dependent
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_FREE_THREADING=
# Log format: `text` or `json` (structured logging for cloud platforms)
# 默认（官方文档）：`text`
# HINDSIGHT_API_LOG_FORMAT=text
# Comma-separated allowlist of JSON log fields to emit (e.g. `severity,message,tenant`). Available: `severity`,
# `message`, `timestamp`, `logger`, `tenant`, `exception`. Empty = all fields.
# 默认（官方文档）：`""` (all)
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_LOG_JSON_FIELDS=
# Enable MCP server at `/mcp/{bank_id}/`
# 默认（官方文档）：`true`
# HINDSIGHT_API_MCP_ENABLED=true
# Wall-clock cap (seconds) on startup model/connection initialization. If embeddings or the cross-encoder block (e.g.
# an offline model download), the server fails fast with a clear error instead of hanging forever. Increase if a
# legitimate first-time model download needs more time.
# 默认（官方文档）：`300`
# HINDSIGHT_API_MODEL_INIT_TIMEOUT=300
# **Docker image only.** How long the container waits for the API to answer `/health` before it stops and restarts.
# Raising `HINDSIGHT_API_MODEL_INIT_TIMEOUT` above the default raises this wait too, so a slow first-time model
# download is not cut short; set this to override the wait on its own.
# 默认（官方文档）：`300`, or `HINDSIGHT_API_MODEL_INIT_TIMEOUT` + 30s when that is longer
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_STARTUP_WAIT_SECONDS=

# =============================================================================
# 官方文档补充 / Retrieval
# =============================================================================
# Graph retrieval algorithm
# 默认（官方文档）：`link_expansion`
# HINDSIGHT_API_GRAPH_RETRIEVER=link_expansion
# Max target units expanded per entity in `link_expansion` graph retrieval (LATERAL fanout cap per entity; bounds
# high-fanout entities).
# 默认（官方文档）：`200`
# HINDSIGHT_API_LINK_EXPANSION_PER_ENTITY_LIMIT=200
# Timeout (seconds) for the graph expansion queries in `link_expansion` retrieval. On timeout, world/experience
# expansion falls back to semantic+causal links; observation expansion returns no graph results.
# 默认（官方文档）：`10`
# HINDSIGHT_API_LINK_EXPANSION_TIMEOUT=10
# Max concurrent recall operations per worker (backpressure)
# 默认（官方文档）：`32`
# HINDSIGHT_API_RECALL_MAX_CONCURRENT=32
# Max concurrent DB connections per recall operation
# 默认（官方文档）：`4`
# HINDSIGHT_API_RECALL_CONNECTION_BUDGET=4
# Maximum token length of a recall query. Longer queries are cut to the limit instead of failing. `0` disables the
# limit.
# 默认（官方文档）：`500`
# HINDSIGHT_API_RECALL_MAX_QUERY_TOKENS=500
# Restrict the locales `dateparser` considers when extracting temporal constraints from a recall query, as a
# comma-separated list of language codes (e.g. `en` or `en,zh`). Empty keeps full auto-detection across all supported
# locales. Restricting is significantly faster (auto-detection dominates recall's CPU cost) and avoids locale
# misdetection on a known-language corpus, but explicit dates written in an unlisted locale will then misparse rather
# than yield no constraint — only set this when you know which languages your queries use. Does not affect Chinese,
# which is handled before `dateparser` runs.
# 默认（官方文档）：_(empty)_
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_QUERY_ANALYZER_LANGUAGES=
# Minimum BM25 score a row must exceed to enter fusion. Gates out zero-score, non-matching rows on backends (notably
# `vchord`) whose operator ranks every document instead of pre-filtering to query-term matches. `0` keeps only
# genuine term matches; raise it to require stronger matches.
# 默认（官方文档）：`0`
# HINDSIGHT_API_BM25_MIN_SCORE=0
# Cap on candidates each retrieval source (semantic, BM25, graph, temporal) contributes to RRF, applied before the
# global reranker cap. Prevents one over-expanding backend from filling the reranker budget on its own. `0` disables
# the cap.
# 默认（官方文档）：`0`
# HINDSIGHT_API_RECALL_MAX_CANDIDATES_PER_SOURCE=0
# Prioritise one or more retrieval sources over the others on recall, as a comma-separated `strategy:level` list
# (e.g. `graph:high` to strongly favour graph hits, or `graph:high,bm25:low`). Strategies: `semantic`, `bm25`,
# `graph`, `temporal`. Levels: `low` (gentle — mainly protects the source's candidates from being dropped before
# reranking), `medium` (moderate preference), `high` (strong — the source takes the large majority of the reranker's
# candidate budget). The pre-cap boost works in rank space and only runs when the merged pool is larger than
# `HINDSIGHT_API_RERANKER_MAX_CANDIDATES`; it does not rewrite RRF scores. Comparing one boosted arm with one other
# arm, a boosted candidate at rank `r` outranks the other arm's candidate at rank `s` when `r < divisor * s`
# (divisors: `low` 2, `medium` 4, `high` 8). That is a single-arm comparison, not a guarantee about the fused list,
# and it does not depend on pool size. After a cross-encoder rerank, each favoured candidate gets an additive nudge
# that is the level's full amount at rank 1 and shrinks with its rank in that source (rank-1 amounts: `low` 0.05,
# `medium` 0.2, `high` 0.5). The decay reuses the same divisor as an initial scale, so `high` halves by rank 9. The
# `temporal` strategy is the exception: its rank is mostly how close a memory's date is to the middle of the query's
# date window, which says nothing about relevance among the memories inside the window, so every candidate the
# temporal source surfaced (including memories linked to those) gets the full amount whatever its rank. For the other
# sources the decay reduces how far a deep hit moves. For every source, the nudge does not cap the final rank change,
# it does not guarantee a strong direct match stays ahead, and nudges from two arms add. On a passthrough reranker —
# recall mode `rrf`, a provider named `rrf`, or a failover chain that has degraded to its `rrf` member — that
# post-rerank nudge is skipped. If the pool is within the cap, the setting then has no effect; if the pool exceeds
# the cap, it only changes which candidates enter, and the final order follows raw RRF plus the recency, temporal and
# proof multipliers. Only the strategies you list are boosted — any you omit keep their normal weight (no implicit
# boost). A strategy written without a level (`graph` or `graph:`) defaults to `medium`. Empty disables the feature.
# 默认（官方文档）：_(empty)_
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_RECALL_STRATEGY_BOOSTS=
# Shape of the recency boost applied during reranking — how a memory's age is turned into a small freshness
# adjustment to its final rank. `linear` (default) decays in a straight line from full freshness (today) to a floor
# reached at `HINDSIGHT_API_RECENCY_DECAY_LINEAR_WINDOW_DAYS`. `exponential` decays by half-life: a memory is treated
# as neutral (no boost or penalty) at `HINDSIGHT_API_RECENCY_DECAY_HALFLIFE_DAYS`, younger memories are boosted and
# older ones penalised, with a smooth fade rather than a hard cutoff. `none` disables recency entirely (age never
# affects ranking).
# 默认（官方文档）：`linear`
# HINDSIGHT_API_RECENCY_DECAY_FUNCTION=linear
# For the `linear` decay function: the number of days over which a memory fades from full freshness to the minimum.
# Only used when `HINDSIGHT_API_RECENCY_DECAY_FUNCTION=linear`.
# 默认（官方文档）：`365`
# HINDSIGHT_API_RECENCY_DECAY_LINEAR_WINDOW_DAYS=365
# For the `exponential` decay function: the age (in days) at which a memory is considered neutral — younger memories
# get a recency boost, older ones a penalty. Smaller values favour very recent memories more aggressively. Only used
# when `HINDSIGHT_API_RECENCY_DECAY_FUNCTION=exponential`.
# 默认（官方文档）：`90`
# HINDSIGHT_API_RECENCY_DECAY_HALFLIFE_DAYS=90
# Track history of content changes to each mental model (previous content + timestamp), stored one row per change in
# the `mental_model_history` table. Set to `false` to disable entirely — no history rows are written, reducing
# storage if audit trails are not needed. **This is how you turn the feature off** (not a zero cap).
# 默认（官方文档）：`true`
# HINDSIGHT_API_ENABLE_MENTAL_MODEL_HISTORY=true
# Max history rows kept per mental model. On each refresh the previous version is inserted into the
# `mental_model_history` table and the oldest rows beyond this cap are deleted, so per-model history can't grow
# without bound. `0` or a negative value **removes the cap** (history then grows with every refresh — unbounded); to
# turn history off entirely set `HINDSIGHT_API_ENABLE_MENTAL_MODEL_HISTORY=false` instead.
# 默认（官方文档）：`50`
# HINDSIGHT_API_MENTAL_MODEL_HISTORY_MAX_ENTRIES=50

# =============================================================================
# 官方文档补充 / Recall budget mapping
# =============================================================================
# Mapping function: `fixed` or `adaptive`.
# 默认（官方文档）：`fixed`
# HINDSIGHT_API_RECALL_BUDGET_FUNCTION=fixed
# Items per retrieval method per fact type when `budget=low` and function is `fixed`.
# 默认（官方文档）：`100`
# HINDSIGHT_API_RECALL_BUDGET_FIXED_LOW=100
# Items per retrieval method per fact type when `budget=mid` and function is `fixed`.
# 默认（官方文档）：`300`
# HINDSIGHT_API_RECALL_BUDGET_FIXED_MID=300
# Items per retrieval method per fact type when `budget=high` and function is `fixed`.
# 默认（官方文档）：`1000`
# HINDSIGHT_API_RECALL_BUDGET_FIXED_HIGH=1000
# Ratio of request `max_tokens` used when `budget=low` and function is `adaptive`.
# 默认（官方文档）：`0.025`
# HINDSIGHT_API_RECALL_BUDGET_ADAPTIVE_LOW=0.025
# Ratio of request `max_tokens` used when `budget=mid` and function is `adaptive`.
# 默认（官方文档）：`0.075`
# HINDSIGHT_API_RECALL_BUDGET_ADAPTIVE_MID=0.075
# Ratio of request `max_tokens` used when `budget=high` and function is `adaptive`.
# 默认（官方文档）：`0.25`
# HINDSIGHT_API_RECALL_BUDGET_ADAPTIVE_HIGH=0.25
# Floor for the adaptive function (after clamping).
# 默认（官方文档）：`20`
# HINDSIGHT_API_RECALL_BUDGET_MIN=20
# Ceiling for the adaptive function (after clamping).
# 默认（官方文档）：`2000`
# HINDSIGHT_API_RECALL_BUDGET_MAX=2000

# =============================================================================
# 官方文档补充 / Retain
# =============================================================================
# Max completion tokens for fact extraction LLM calls
# 默认（官方文档）：`64000`
# HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=64000
# Max characters per chunk for fact extraction. Larger chunks extract fewer LLM calls but may lose context.
# 默认（官方文档）：`3000`
# HINDSIGHT_API_RETAIN_CHUNK_SIZE=3000
# Fact extraction mode: `concise`, `verbose`, `verbatim`, `chunks`, or `custom`
# 默认（官方文档）：`concise`
# HINDSIGHT_API_RETAIN_EXTRACTION_MODE=concise
# What this bank should pay attention to during extraction. Steers the LLM without replacing the extraction rules —
# works alongside any extraction mode.
# 默认（官方文档）：-
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_RETAIN_MISSION=
# Full prompt override for fact extraction (only used when mode is `custom`). Replaces built-in extraction rules
# entirely.
# 默认（官方文档）：-
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_RETAIN_CUSTOM_INSTRUCTIONS=
# Extract causal relationships between facts
# 默认（官方文档）：`true`
# HINDSIGHT_API_RETAIN_EXTRACT_CAUSAL_LINKS=true
# Use LLM Batch API for fact extraction (50% cost savings, only with async operations)
# 默认（官方文档）：`false`
# HINDSIGHT_API_RETAIN_BATCH_ENABLED=false
# Max concurrent retain DB phases (HNSW reads + writes). Limits I/O contention during high-concurrency ingestion.
# 默认（官方文档）：`4`
# HINDSIGHT_API_RETAIN_MAX_CONCURRENT=4
# Sub-batches of one document processed at a time. Most of a sub-batch is a store round-trip, so overlapping a few
# hides that wait. `1` keeps the splitter one slice ahead of the work, which bounds how much of a large document is
# resident.
# 默认（官方文档）：`1`
# HINDSIGHT_API_RETAIN_SUBBATCH_CONCURRENCY=1
# Max characters per sub-batch for async retain auto-splitting
# 默认（官方文档）：`10000`
# HINDSIGHT_API_RETAIN_BATCH_TOKENS=10000
# Max chunks per streaming batch when retain ingests long documents. Each chunk produces roughly 17 facts, so the
# default 100 chunks ≈ 1700 facts per batch. Lower to cap memory/LLM pressure on large documents; raise for smaller
# chunks. Configurable per bank.
# 默认（官方文档）：`100`
# HINDSIGHT_API_RETAIN_CHUNK_BATCH_SIZE=100
# How retain finds *candidate* existing entities for an extracted name: `trigram` probes the pg_trgm index for
# similar names, `full` loads every entity in the bank and keeps the ones whose name is an exact or substring match.
# Both then run the same scoring pass (see [How entity resolution decides](#how-entity-resolution-decides)) — so this
# is not only a performance choice, it changes which names can merge at all.
# 默认（官方文档）：`trigram`
# HINDSIGHT_API_RETAIN_ENTITY_LOOKUP=trigram
# Max unique entity names per fuzzy candidate lookup query (`trigram` on PG, `oracle_fuzzy` on Oracle). Bounds query
# size so very wide retain batches don't time out a single `unnest(...)` join on banks with many entities.
# 默认（官方文档）：`100`
# HINDSIGHT_API_RETAIN_ENTITY_RESOLUTION_BATCH_SIZE=100
# Default retain strategy name. When set, all retain calls without an explicit `strategy` parameter use this
# strategy.
# 默认（官方文档）：-
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_RETAIN_DEFAULT_STRATEGY=
# How often a retain waits between status checks against the **LLM provider's** Batch API while a submitted batch job
# runs. This is not a worker or ingestion knob — it does not control how often Hindsight picks up pending retains
# (see [`HINDSIGHT_API_WORKER_POLL_INTERVAL_MS`](#distributed-workers) for that) and only applies when the provider's
# batch mode is in use. Setting it to `0` does not disable anything: it removes the wait entirely and polls the
# provider's status endpoint in a tight loop.
# 默认（官方文档）：`60`
# HINDSIGHT_API_RETAIN_BATCH_POLL_INTERVAL_SECONDS=60
# Persist the raw source text alongside extracted memories. Set to `false` to skip storing it
# (`documents.original_text` NULL, `chunks.chunk_text` empty). Hierarchical — overridable per bank via the [config
# API](#hierarchical-configuration), so a data-minimizing bank can keep only derived facts while others retain the
# raw source.
# 默认（官方文档）：`true`
# HINDSIGHT_API_STORE_DOCUMENT_TEXT=true

# =============================================================================
# 官方文档补充 / Fireworks batch inference
# =============================================================================
# Fireworks account id. **Required** for `fireworks` batch retain — the control-plane endpoints are
# `/v1/accounts/{account_id}/...`. Static, server-level.
# 默认（官方文档）：-
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_FIREWORKS_ACCOUNT_ID=
# Fireworks batch control-plane host.
# 默认（官方文档）：`https://api.fireworks.ai`
# HINDSIGHT_API_FIREWORKS_BATCH_BASE_URL=https://api.fireworks.ai
# Max time to wait for a batch job before surfacing a failure. Guards against the Fireworks gotcha where a
# non-batch-eligible model leaves the job `PENDING` forever.
# 默认（官方文档）：`86400` (24h)
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_FIREWORKS_BATCH_MAX_WAIT_SECONDS=

# =============================================================================
# 官方文档补充 / File Processing
# =============================================================================
# Enable the file upload API endpoint
# 默认（官方文档）：`true`
# HINDSIGHT_API_ENABLE_FILE_UPLOAD_API=true
# Enable the [document export](./api/memory-banks.mdx#document-export--import-superseded) endpoint (`GET
# /document-transfer`)
# 默认（官方文档）：`true`
# HINDSIGHT_API_ENABLE_DOCUMENT_EXPORT_API=true
# Enable the [document import](./api/memory-banks.mdx#document-export--import-superseded) endpoint (`POST
# /document-transfer`)
# 默认（官方文档）：`true`
# HINDSIGHT_API_ENABLE_DOCUMENT_IMPORT_API=true
# Comma-separated list of parsers clients are allowed to request. If not set, all registered parsers are allowed.
# 默认（官方文档）：—
# 填写位置：未给出单一固定默认值；不要仅取消注释为空，应先按上方说明填写。
# HINDSIGHT_API_FILE_PARSER_ALLOWLIST=
# Max files per upload request
# 默认（官方文档）：`10`
# HINDSIGHT_API_FILE_CONVERSION_MAX_BATCH_SIZE=10
# Max total upload size per request (MB)
# 默认（官方文档）：`100`
# HINDSIGHT_API_FILE_CONVERSION_MAX_BATCH_SIZE_MB=100
# Delete stored files after memory extraction completes
# 默认（官方文档）：`true`
# HINDSIGHT_API_FILE_DELETE_AFTER_RETAIN=true

